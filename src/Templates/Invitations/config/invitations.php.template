<?php

declare(strict_types=1);

/**
 * Invitation configuration — generated by `php stone generate invitations`.
 *
 * Mirrors config/auth.php's existing pattern: this is where THIS platform
 * wires its own role model and tenant-membership storage into the
 * framework-shipped InvitationCompletionService, via the two closures
 * below. Edit freely — everything here is platform-owned, per design doc §0.
 */
return [
    // Base URL of this platform's Angular app, used to build the invite
    // link emailed to invitees, e.g. https://app.medstoreapp.in
    'portal_base_url' => getenv('PORTAL_BASE_URL') ?: '',

    // How long a created invitation stays valid, in days.
    'expiry_days' => 7,

    // Display name used in the invite email subject/body.
    'app_name' => getenv('APP_NAME') ?: '',

    // fn(InvitationRecord $invitation): string
    //
    // Decides the role actually granted on accept. Default below simply
    // trusts the role stored on the invitation row at creation time
    // (design doc §3.4 step 5 — role authority lives in
    // platform_invitations.role, never an auth claim). Override this if
    // this platform needs to re-validate or re-map roles at accept time.
    'role_resolver' => function (\StoneScriptPHP\Auth\Invitations\InvitationRecord $invitation): string {
        return $invitation->role;
    },

    // fn(InvitationRecord $invitation, array $passportClaims, string $role): array
    //
    // Writes THIS platform's own tenant-membership record — whatever
    // table/shape this platform already uses (e.g. aasaanwork's
    // customers/vendors tables with an auth_identity_id column,
    // medstoreapp's own membership model, or a fresh table for a new
    // platform). MUST return an array containing at least a `tenant_id`
    // string key; every other key is passed through as-is into the
    // accept-invite response's `membership` field.
    //
    // Left throwing on purpose — a platform should not be able to silently
    // ship accept-invite without ever granting real tenant access.
    'membership_writer' => function (
        \StoneScriptPHP\Auth\Invitations\InvitationRecord $invitation,
        array $passportClaims,
        string $role
    ): array {
        throw new \RuntimeException(
            "config/invitations.php: 'membership_writer' is not implemented yet. "
            . 'Wire it to this platform\'s own tenant-membership table before enabling accept-invite.'
        );
    },

    // Passport (identity token) validation config — same JWKS endpoint
    // every other passport-consuming route in this platform already uses
    // (see config/auth.php / ExternalAuthConfig's jwks_url default).
    'auth' => [
        'jwks_url' => rtrim((string) (getenv('AUTH_SERVICE_URL') ?: ''), '/') . '/api/auth/jwks',
        'issuer'   => getenv('AUTH_ISSUER') ?: '',
        'audience' => null,
    ],

    // Server-to-server create-membership call + (T2 only) local card
    // minting config.
    'platform' => [
        'platform_secret' => getenv('EXTERNAL_AUTH_CLIENT_SECRET') ?: null,
        'platform_code'   => getenv('PLATFORM_CODE') ?: '',

        // T2 (card-model) platforms: leave true to mint a local card on
        // accept, same pattern as ProvisionTenantRoute::mintProvisionCard().
        // T3 platforms (medstoreapp-style, tenant-less identity JWT +
        // explicit tenant_id): set false to get the passthrough
        // identity-token + tenant_id contract instead (design doc §3.4.2).
        'card' => true,
        'signing_private_key_path'       => getenv('JWT_PRIVATE_KEY_PATH') ?: '',
        'signing_private_key_passphrase' => getenv('JWT_PRIVATE_KEY_PASSPHRASE') ?: null,
        'signing_issuer'                 => getenv('JWT_ISSUER') ?: '',
        'ttl'                             => 3600,
    ],
];

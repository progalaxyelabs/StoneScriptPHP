<?php

declare(strict_types=1);

namespace App\Routes\Invitations;

use StoneScriptPHP\ApiResponse;
use StoneScriptPHP\IRouteHandler;

/**
 * GET {prefix}/invitations/{token}
 *
 * Generated by `php stone generate invitations`. PUBLIC — no auth required.
 * Returns minimal, non-sensitive display info so the accept-invite page can
 * render "You've been invited to join X as a Y" before the user commits to
 * anything (design doc §3.5 step 2). Register this route with `is_public`
 * set true in routes.php — it deliberately never returns the token hash or
 * any other platform_invitations column beyond email/role/expires_at.
 */
class GetInvitationRoute implements IRouteHandler
{
    public string $token = '';

    public function validation_rules(): array
    {
        return [
            'token' => 'required|string',
        ];
    }

    public function process(): ApiResponse
    {
        $repository = new PlatformInvitationRepository();
        $tokenHash  = hash('sha256', $this->token);
        $invitation = $repository->findByTokenHash($tokenHash);

        if ($invitation === null) {
            return res_error('Invitation not found', 404);
        }

        if ($invitation->status !== 'pending') {
            return res_error('Invitation has already been used', 409);
        }

        if (new \DateTimeImmutable($invitation->expiresAt) < new \DateTimeImmutable('now', new \DateTimeZone('UTC'))) {
            return res_error('Invitation has expired', 410);
        }

        return res_ok([
            'email'      => $invitation->email,
            'role'       => $invitation->role,
            'expires_at' => $invitation->expiresAt,
        ]);
    }
}

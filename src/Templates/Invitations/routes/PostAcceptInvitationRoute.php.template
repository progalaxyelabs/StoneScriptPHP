<?php

declare(strict_types=1);

namespace App\Routes\Invitations;

use StoneScriptPHP\ApiResponse;
use StoneScriptPHP\Auth\BearerToken;
use StoneScriptPHP\Auth\ExternalAuth\ExternalAuthServiceClient;
use StoneScriptPHP\Auth\Invitations\InvitationCompletionService;
use StoneScriptPHP\Auth\Invitations\InvitationException;
use StoneScriptPHP\Auth\TokenExchangeService;
use StoneScriptPHP\IRouteHandler;

/**
 * POST {prefix}/invitations/{token}/accept
 *
 * Generated by `php stone generate invitations`. PUBLIC at the platform-JWT
 * layer — register with `is_public` set true in routes.php. The caller
 * presents an auth-issued PASSPORT in `Authorization: Bearer`, never a
 * platform card, so the normal card-auth middleware must NOT gate this
 * route — it mirrors ExchangeRoute's own public+JWKS-validated pattern
 * The passport proves identity; the invite
 * token (path param) proves invitation ownership. Both are validated inside
 * InvitationCompletionService::complete() below.
 *
 * Delegates ALL orchestration (token-hash lookup, expiry check, passport
 * JWKS validation, email-match guard, create-membership call, card mint /
 * T3 passthrough) to the framework-shipped InvitationCompletionService —
 * see vendor/progalaxyelabs/stonescriptphp's
 * src/Auth/Invitations/InvitationCompletionService.php. This route supplies
 * only the two platform-specific decisions the service deliberately does
 * NOT make itself: the granted role, and the tenant-side membership write
 * ("roles belong in api/platform"), both wired via
 * config/invitations.php.
 */
class PostAcceptInvitationRoute implements IRouteHandler
{
    public string $token = '';

    public function validation_rules(): array
    {
        return [
            'token' => 'required|string',
        ];
    }

    public function process(): ApiResponse
    {
        $passportToken = $this->getBearerToken();
        if ($passportToken === null || $passportToken === '') {
            return res_error('Authorization required', 401);
        }

        $config = require ROOT_PATH . 'config/invitations.php';

        $repository = new PlatformInvitationRepository();
        $service = new InvitationCompletionService(
            new TokenExchangeService(),
            new ExternalAuthServiceClient()
        );

        try {
            $result = $service->complete(
                $this->token,
                $passportToken,
                $repository,
                $config['role_resolver'],
                $config['membership_writer'],
                $config['auth'],
                $config['platform']
            );
        } catch (InvitationException $e) {
            return new ApiResponse('error', $e->getMessage(), ['error' => $e->getErrorCode()], $e->getHttpStatusCode());
        }

        return res_ok($result, 'Invitation accepted');
    }

    /**
     * Manually extract the raw Bearer token — this route is PUBLIC, so
     * JwtAuthMiddleware never runs and never populates auth(); the passport
     * is validated inside InvitationCompletionService instead. Mirrors
     * BaseExternalAuthRoute::getBearerToken() (framework-internal, not
     * reusable from platform code) using the same canonical
     * StoneScriptPHP\Auth\BearerToken::strip() utility.
     */
    private function getBearerToken(): ?string
    {
        $headerValue = null;

        if (function_exists('getallheaders')) {
            foreach (getallheaders() as $name => $value) {
                if (strtolower($name) === 'authorization') {
                    $headerValue = $value;
                    break;
                }
            }
        }

        if ($headerValue === null && isset($_SERVER['HTTP_AUTHORIZATION'])) {
            $headerValue = $_SERVER['HTTP_AUTHORIZATION'];
        }

        if ($headerValue === null && isset($_SERVER['REDIRECT_HTTP_AUTHORIZATION'])) {
            $headerValue = $_SERVER['REDIRECT_HTTP_AUTHORIZATION'];
        }

        return BearerToken::strip($headerValue);
    }
}

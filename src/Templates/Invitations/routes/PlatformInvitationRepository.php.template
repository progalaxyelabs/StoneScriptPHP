<?php

declare(strict_types=1);

namespace App\Routes\Invitations;

use App\Database\Functions\FnCreatePlatformInvitation;
use App\Database\Functions\FnGetPlatformInvitationByTokenHash;
use App\Database\Functions\FnMarkPlatformInvitationAccepted;
use StoneScriptPHP\Auth\Invitations\InvitationRecord;
use StoneScriptPHP\Auth\Invitations\InvitationRepositoryInterface;

/**
 * PlatformInvitationRepository
 *
 * Generated by `php stone generate invitations`. Backed by the three
 * platform_invitations SQL functions (src/postgresql/functions/) via the
 * standard `php stone generate model` wrappers under
 * App\Database\Functions — never handcoded Database::fn() calls, per this
 * framework's convention.
 *
 * You own this file — edit freely. Only findByTokenHash() and
 * markAccepted() are required to satisfy InvitationRepositoryInterface, the
 * contract the framework-shipped InvitationCompletionService depends on
 * (StoneScriptPHP\Auth\Invitations\InvitationCompletionService — ships in
 * the framework package, not generated here). create() is this platform's
 * own addition, used by PostCreateInvitationRoute.
 */
class PlatformInvitationRepository implements InvitationRepositoryInterface
{
    /**
     * Create a new pending invitation and return its full record.
     */
    public function create(
        string $email,
        string $role,
        string $invitedBy,
        string $tokenHash,
        \DateTimeInterface $expiresAt
    ): InvitationRecord {
        $rows = FnCreatePlatformInvitation::run(
            $email,
            $role,
            $invitedBy,
            $tokenHash,
            $expiresAt->format('Y-m-d H:i:s')
        );

        $model = $rows[0] ?? null;
        if ($model === null) {
            throw new \RuntimeException('create_platform_invitation returned no row');
        }

        return $this->toRecord($model);
    }

    /**
     * {@inheritdoc}
     */
    public function findByTokenHash(string $tokenHash): ?InvitationRecord
    {
        $rows = FnGetPlatformInvitationByTokenHash::run($tokenHash);
        $model = $rows[0] ?? null;

        return $model === null ? null : $this->toRecord($model);
    }

    /**
     * {@inheritdoc}
     */
    public function markAccepted(string $id, string $identityId): void
    {
        FnMarkPlatformInvitationAccepted::run($id, $identityId);
    }

    private function toRecord(object $model): InvitationRecord
    {
        return new InvitationRecord(
            id: (string) $model->id,
            email: (string) $model->email,
            role: (string) $model->role,
            status: (string) $model->status,
            expiresAt: (string) $model->expires_at,
            invitedBy: $this->nullIfEmpty($model->invited_by),
            acceptedAt: $this->nullIfEmpty($model->accepted_at),
            acceptedByIdentityId: $this->nullIfEmpty($model->accepted_by_identity_id),
        );
    }

    /**
     * `php stone generate model`'s generated wrappers type nullable
     * TIMESTAMPTZ/UUID output columns as non-nullable `string` properties
     * (see Database::array_to_class_object()) — a NULL from Postgres arrives
     * here as `''`, not PHP `null`. Normalize back to `null` so
     * InvitationRecord's nullable fields (accepted_at, etc., which ARE
     * legitimately unset for a still-pending invitation) mean what they say.
     */
    private function nullIfEmpty($value): ?string
    {
        if ($value === null || $value === '') {
            return null;
        }

        return (string) $value;
    }
}

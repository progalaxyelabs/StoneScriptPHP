<?php

declare(strict_types=1);

namespace App\Routes\Invitations;

use StoneScriptPHP\ApiResponse;
use StoneScriptPHP\IRouteHandler;
use StoneScriptPHP\Lib\Email\MyZeptoMail;

// TODO: import this platform's own privileged-role authorization helper —
// e.g. `use App\Lib\AdminScope;` (aasaanwork-platform's pattern, see
// PostInviteCustomerRoute.php-style routes). The framework generator cannot
// know which roles may invite, or what roles they may grant — that decision
// is 100% platform-owned, per design doc §0 ("roles belong in api/platform").

/**
 * POST {prefix}/invitations
 *
 * Generated by `php stone generate invitations`. Creates a pending
 * invitation row in THIS platform's OWN database (platform_invitations
 * table) — never calls the auth service. Auth only gets involved later,
 * server-to-server, once the invite is accepted (see
 * PostAcceptInvitationRoute + the framework-shipped
 * InvitationCompletionService).
 *
 * ⚠️  AUTHORIZATION IS NOT WIRED HERE — this route only validates request
 * SHAPE (email/role), not WHO may call it or WHAT role they may grant. Add
 * this platform's own check (e.g. AdminScope::requireConsultant()) as the
 * first line of process() before shipping. Left as-is, any authenticated
 * caller could invite anyone at any role.
 *
 * You own this file — edit freely, e.g. to enforce which roles a given
 * caller's own role may grant, or to change the invite email content.
 */
class PostCreateInvitationRoute implements IRouteHandler
{
    public string $email = '';
    public string $role = '';

    public function validation_rules(): array
    {
        return [
            'email' => 'required|email|max:255',
            'role'  => 'required|string|max:50',
        ];
    }

    public function process(): ApiResponse
    {
        // TODO: uncomment/adapt once this platform's own authorization
        // helper is wired in:
        // AdminScope::requireConsultant();

        $user = auth();
        if (!$user || !isset($user->user_id)) {
            return res_error('Authorization required', 401);
        }

        $config = require ROOT_PATH . 'config/invitations.php';

        $rawToken  = bin2hex(random_bytes(32));
        $tokenHash = hash('sha256', $rawToken);
        $expiresAt = new \DateTimeImmutable('+' . ($config['expiry_days'] ?? 7) . ' days');

        $repository = new PlatformInvitationRepository();
        $invitation = $repository->create(
            strtolower(trim($this->email)),
            $this->role,
            (string) $user->user_id,
            $tokenHash,
            $expiresAt
        );

        $inviteUrl = rtrim((string) ($config['portal_base_url'] ?? ''), '/')
            . '/auth/accept-invite?token=' . urlencode($rawToken);

        $this->sendInviteEmail($invitation->email, $inviteUrl, $config);

        return res_ok([
            'id'         => $invitation->id,
            'email'      => $invitation->email,
            'role'       => $invitation->role,
            'expires_at' => $invitation->expiresAt,
            // The raw token / invite_url is only echoed back outside
            // production — real invitees should only ever see it via the
            // emailed link.
            'invite_url' => (getenv('APP_ENV') === 'development') ? $inviteUrl : null,
        ], 'Invitation created');
    }

    private function sendInviteEmail(string $email, string $inviteUrl, array $config): void
    {
        $emailService = new MyZeptoMail();
        if (!$emailService->isConfigured()) {
            log_warning('PostCreateInvitationRoute: email service not configured, skipping invite email');
            return;
        }

        $appName = $config['app_name'] ?: (getenv('APP_NAME') ?: 'our platform');

        $sent = $emailService->send(
            $email,
            "You've been invited to join {$appName}",
            '<p>You have been invited to join ' . htmlspecialchars($appName, ENT_QUOTES)
                . '.</p><p><a href="' . htmlspecialchars($inviteUrl, ENT_QUOTES) . '">Accept invitation</a></p>'
        );

        if (!$sent) {
            log_warning("PostCreateInvitationRoute: failed to send invite email to {$email}");
        }
    }
}

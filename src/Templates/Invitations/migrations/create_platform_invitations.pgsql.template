-- Platform-owned invitations table.
--
-- Generated by `php stone generate invitations`. Owned entirely by THIS
-- platform's own database — never the external auth service. The
-- rationale: an invitation is a tenant
-- membership decision, so it lives in the same DB scope as the tenant it
-- invites into, not in auth's shared identity DB. Auth is only ever told
-- about the RESULT (a membership now exists), server-to-server, after this
-- platform has already validated and accepted the invite — never about the
-- invitation itself.
--
-- Non-destructive, idempotent DDL only — safe to re-run on any tenant at
-- any state (per this framework's migration-safety rule: additive schema
-- changes only, IF NOT EXISTS guards throughout, nothing that removes data).
CREATE TABLE IF NOT EXISTS platform_invitations (
    id                       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email                    VARCHAR(255) NOT NULL,
    role                     VARCHAR(50)  NOT NULL,   -- platform-defined vocabulary, no CHECK constraint here on purpose
    invited_by               UUID         NOT NULL,   -- identity_id of the inviter
    token_hash               VARCHAR(64)  NOT NULL UNIQUE, -- sha256 hex of the raw token — the raw token is NEVER stored
    status                   VARCHAR(20)  NOT NULL DEFAULT 'pending', -- pending|accepted|expired|revoked
    expires_at               TIMESTAMPTZ  NOT NULL,
    accepted_at              TIMESTAMPTZ,
    accepted_by_identity_id  UUID,                    -- filled in on accept, from the auth passport
    created_at               TIMESTAMPTZ  NOT NULL DEFAULT now(),
    updated_at               TIMESTAMPTZ  NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_platform_invitations_email  ON platform_invitations(email);
CREATE INDEX IF NOT EXISTS idx_platform_invitations_status ON platform_invitations(status);

-- NOTE for T3 (shared-schema multi-tenancy) platforms:
-- this table has no `tenant_id` column by design — T2 (tenant-per-DB)
-- platforms don't need one, since the whole database already IS the
-- tenant. If this platform is T3, add your own
-- `tenant_id UUID NOT NULL` column (+ index) to this migration BEFORE
-- running it, and populate InvitationRecord::$tenantId from your generated
-- PlatformInvitationRepository accordingly — the framework does not
-- prescribe either model.

-- Generated by `php stone generate invitations`.
-- Looks up an invitation by the sha256 hex hash of its raw token — never
-- the raw token itself. Called by PlatformInvitationRepository::findByTokenHash()
-- (via the `php stone generate model` wrapper FnGetPlatformInvitationByTokenHash),
-- which InvitationCompletionService::complete() depends on.
CREATE OR REPLACE FUNCTION get_platform_invitation_by_token_hash(
    i_token_hash TEXT
)
RETURNS TABLE (
    o_id UUID,
    o_email TEXT,
    o_role TEXT,
    o_invited_by UUID,
    o_status TEXT,
    o_expires_at TIMESTAMPTZ,
    o_accepted_at TIMESTAMPTZ,
    o_accepted_by_identity_id UUID,
    o_created_at TIMESTAMPTZ
)
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN QUERY
    SELECT
        platform_invitations.id,
        platform_invitations.email,
        platform_invitations.role,
        platform_invitations.invited_by,
        platform_invitations.status,
        platform_invitations.expires_at,
        platform_invitations.accepted_at,
        platform_invitations.accepted_by_identity_id,
        platform_invitations.created_at
    FROM platform_invitations
    WHERE platform_invitations.token_hash = i_token_hash;
END;
$$;

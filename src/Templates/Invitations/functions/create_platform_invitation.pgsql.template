-- Generated by `php stone generate invitations`.
-- Creates a pending invitation row. Called by PlatformInvitationRepository::create()
-- (via the `php stone generate model` wrapper FnCreatePlatformInvitation).
CREATE OR REPLACE FUNCTION create_platform_invitation(
    i_email TEXT,
    i_role TEXT,
    i_invited_by UUID,
    i_token_hash TEXT,
    i_expires_at TIMESTAMPTZ
)
RETURNS TABLE (
    o_id UUID,
    o_email TEXT,
    o_role TEXT,
    o_invited_by UUID,
    o_status TEXT,
    o_expires_at TIMESTAMPTZ,
    o_accepted_at TIMESTAMPTZ,
    o_accepted_by_identity_id UUID,
    o_created_at TIMESTAMPTZ
)
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN QUERY
    INSERT INTO platform_invitations (email, role, invited_by, token_hash, expires_at)
    VALUES (lower(trim(i_email)), i_role, i_invited_by, i_token_hash, i_expires_at)
    RETURNING
        platform_invitations.id,
        platform_invitations.email,
        platform_invitations.role,
        platform_invitations.invited_by,
        platform_invitations.status,
        platform_invitations.expires_at,
        platform_invitations.accepted_at,
        platform_invitations.accepted_by_identity_id,
        platform_invitations.created_at;
END;
$$;

-- Generated by `php stone generate invitations`.
-- Marks an invitation accepted. Called by PlatformInvitationRepository::markAccepted()
-- (via the `php stone generate model` wrapper FnMarkPlatformInvitationAccepted),
-- InvitationCompletionService::complete()'s final step.
CREATE OR REPLACE FUNCTION mark_platform_invitation_accepted(
    i_id UUID,
    i_accepted_by_identity_id UUID
)
RETURNS TABLE (
    o_id UUID,
    o_status TEXT,
    o_accepted_at TIMESTAMPTZ,
    o_accepted_by_identity_id UUID
)
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN QUERY
    UPDATE platform_invitations
    SET status = 'accepted',
        accepted_at = now(),
        accepted_by_identity_id = i_accepted_by_identity_id,
        updated_at = now()
    WHERE platform_invitations.id = i_id
    RETURNING
        platform_invitations.id,
        platform_invitations.status,
        platform_invitations.accepted_at,
        platform_invitations.accepted_by_identity_id;
END;
$$;

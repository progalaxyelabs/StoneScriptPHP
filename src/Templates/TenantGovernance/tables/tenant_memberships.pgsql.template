-- Platform-owned tenant governance ledger — TENANT-GOVERNANCE.md §2.
--
-- Generated by `php stone generate tenant-governance`. Lives in THIS
-- platform's own main database — never progalaxyelabs-auth, and never a
-- per-tenant database (tenants_resolver/roles_resolver must answer "which
-- tenants does this identity belong to" before any specific tenant's
-- database is even selected).
--
-- Declarative definition (gateway schema-sync source of truth) — mirrors
-- migrations/*_create_tenant_memberships.pgsql's CREATE TABLE exactly, so
-- the gateway's schema differ recognizes this table as declared rather
-- than treating it as drift to drop. The trigger that protects
-- is_tenant_creator lives in the migration (see that file) — it must run
-- after this table physically exists, which a declarative table file
-- alone cannot guarantee at gateway schema-sync time.
CREATE TABLE IF NOT EXISTS tenant_memberships (
    id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    -- Cross-DB reference to progalaxyelabs-auth's identities table. NOT a
    -- foreign key — auth is a separate database/service; referential
    -- integrity here is app-enforced (an identity_id only ever arrives via
    -- a verified JWT claim).
    identity_id         UUID NOT NULL,

    tenant_id           UUID NOT NULL REFERENCES tenants(uuid) ON DELETE CASCADE,

    -- Governance tier (TENANT-GOVERNANCE.md §1.1) — independent booleans,
    -- not an enum, so multiple owners/admins can co-exist and a demoted
    -- owner cleanly falls back to whatever admin/member state they held.
    is_tenant_creator   BOOLEAN NOT NULL DEFAULT false,
    is_tenant_owner     BOOLEAN NOT NULL DEFAULT false,
    is_tenant_admin     BOOLEAN NOT NULL DEFAULT false,

    -- Functional (§1.3) — no permission meaning. Platform-defined
    -- vocabulary, no CHECK constraint here on purpose (mirrors the
    -- invitations generator's `role` column precedent).
    job_role            VARCHAR(100),

    -- Per-tenant status — deliberately separate from auth's own
    -- platform-wide membership-status (§0). 'removed' is a SOFT delete
    -- (§4's remove_member()) — this table never hard-deletes a row that
    -- has ever existed; is_tenant_creator rows never transition here at
    -- all (remove_member() refuses outright — the creator can only be
    -- suspended, never removed).
    status              VARCHAR(20) NOT NULL DEFAULT 'active'
                            CHECK (status IN ('active', 'suspended', 'removed')),

    invited_by          UUID,           -- identity_id of the inviter; NULL for the creator row
    created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),

    CONSTRAINT tenant_memberships_unique_identity_tenant UNIQUE (identity_id, tenant_id)
);

CREATE INDEX IF NOT EXISTS idx_tenant_memberships_identity ON tenant_memberships(identity_id);
CREATE INDEX IF NOT EXISTS idx_tenant_memberships_tenant   ON tenant_memberships(tenant_id);
CREATE INDEX IF NOT EXISTS idx_tenant_memberships_status   ON tenant_memberships(status);

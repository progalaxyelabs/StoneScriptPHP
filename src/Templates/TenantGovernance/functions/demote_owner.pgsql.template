-- Generated by `php stone generate tenant-governance`. TENANT-GOVERNANCE.md §4/§3.2.
--
-- Acting identity must currently be owner. Refuses (cannot_demote_last_owner)
-- if target is the sole remaining active owner — a tenant must always keep
-- >=1 active owner ("someone has to be accountable for the bill"). Sets
-- is_tenant_owner=false — target falls back to whatever is_tenant_admin
-- state they already hold. is_tenant_creator is untouched regardless of
-- outcome ("owners swap on edit" — ownership is fully transferable away
-- from the creator without touching the creator flag itself).
--
-- Locks all of this tenant's active-owner rows (FOR UPDATE) before counting
-- them, closing the race where two concurrent demotions each observe ">1
-- owner" and both proceed — TENANT-GOVERNANCE.md §3.2.
CREATE OR REPLACE FUNCTION demote_owner(
    p_tenant_id UUID,
    p_target_identity_id UUID,
    p_acting_identity_id UUID
)
RETURNS TABLE (o_error TEXT, o_identity_id UUID, o_is_tenant_owner BOOLEAN)
LANGUAGE plpgsql AS $$
DECLARE
    v_acting_tier TEXT;
    v_target tenant_memberships%ROWTYPE;
    v_active_owner_count INTEGER;
BEGIN
    v_acting_tier := _tenant_membership_tier(p_tenant_id, p_acting_identity_id);
    IF v_acting_tier IS DISTINCT FROM 'owner' THEN
        RETURN QUERY SELECT 'not_authorized'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    -- Lock every active-owner row for this tenant before counting, so a
    -- concurrent demote_owner()/remove_member()/set_membership_status() call
    -- targeting a different owner of the same tenant blocks until this
    -- transaction commits, instead of both racing past the count check.
    PERFORM 1 FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND is_tenant_owner AND status = 'active'
     FOR UPDATE;

    SELECT * INTO v_target
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    IF NOT FOUND OR v_target.status <> 'active' THEN
        RETURN QUERY SELECT 'membership_not_found'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    IF NOT v_target.is_tenant_owner THEN
        RETURN QUERY SELECT 'target_is_not_owner'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    SELECT count(*) INTO v_active_owner_count
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND is_tenant_owner AND status = 'active';

    IF v_active_owner_count <= 1 THEN
        RETURN QUERY SELECT 'cannot_demote_last_owner'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    UPDATE tenant_memberships
       SET is_tenant_owner = false, updated_at = NOW()
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    RETURN QUERY SELECT NULL::TEXT, p_target_identity_id, false;
END;
$$;

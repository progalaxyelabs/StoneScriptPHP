-- Generated by `php stone generate tenant-governance`.
--
-- The roles_resolver replacement: returns a single derived role string from
-- the governance flags — 'owner' | 'admin' | 'member' for an active row;
-- NULL for a suspended/removed/nonexistent row (ExchangeRoute treats an
-- empty roles_resolver result as "identity has no roles in this tenant" —
-- exchange refuses with the existing framework contract, unchanged by this
-- feature). This is what actually lands on the card's role_id claim via
-- TenantGovernanceResolver::rolesResolver().
CREATE OR REPLACE FUNCTION resolve_role_id(
    p_identity_id UUID,
    p_tenant_id UUID
)
RETURNS TABLE (o_role_id TEXT)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY SELECT _tenant_membership_tier(p_tenant_id, p_identity_id);
END;
$$;

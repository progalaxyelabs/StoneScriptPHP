-- Generated by `php stone generate tenant-governance`.

-- Acting identity must be owner or admin. SOFT DELETE: sets status='removed'
-- — never a hard DELETE (trg_protect_tenant_creator is the backstop for any
-- OTHER code path, not the enforcement mechanism for this function; this
-- function enforces its own rules directly).
--
-- Refuses outright (cannot_remove_tenant_creator) if target is_tenant_creator
-- — the creator can be suspended via set_membership_status() but never
-- removed, which keeps "record non-deletable" true in spirit, not just at
-- the hard-DELETE level. Refuses (cannot_remove_last_owner) if target is the
-- sole remaining active owner.
--
-- On success, also clears is_tenant_owner=false, is_tenant_admin=false — a
-- removed member holds no standing to silently regain on a later
-- add_member() reactivation.
CREATE OR REPLACE FUNCTION remove_member(
    p_tenant_id UUID,
    p_target_identity_id UUID,
    p_acting_identity_id UUID
)
RETURNS TABLE (o_error TEXT, o_identity_id UUID, o_status TEXT)
LANGUAGE plpgsql AS $$
DECLARE
    v_acting_tier TEXT;
    v_target tenant_memberships%ROWTYPE;
    v_active_owner_count INTEGER;
BEGIN
    v_acting_tier := _tenant_membership_tier(p_tenant_id, p_acting_identity_id);
    IF v_acting_tier IS NULL OR v_acting_tier NOT IN ('owner', 'admin') THEN
        RETURN QUERY SELECT 'not_authorized'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    PERFORM 1 FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND is_tenant_owner AND status = 'active'
     FOR UPDATE;

    SELECT * INTO v_target
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    IF NOT FOUND OR v_target.status = 'removed' THEN
        RETURN QUERY SELECT 'membership_not_found'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    IF v_target.is_tenant_creator THEN
        RETURN QUERY SELECT 'cannot_remove_tenant_creator'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    IF v_target.is_tenant_owner THEN
        SELECT count(*) INTO v_active_owner_count
          FROM tenant_memberships
         WHERE tenant_id = p_tenant_id AND is_tenant_owner AND status = 'active';

        IF v_active_owner_count <= 1 THEN
            RETURN QUERY SELECT 'cannot_remove_last_owner'::TEXT, NULL::UUID, NULL::TEXT;
            RETURN;
        END IF;
    END IF;

    UPDATE tenant_memberships
       SET status = 'removed', is_tenant_owner = false, is_tenant_admin = false, updated_at = NOW()
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    RETURN QUERY SELECT NULL::TEXT, p_target_identity_id, 'removed'::TEXT;
END;
$$;

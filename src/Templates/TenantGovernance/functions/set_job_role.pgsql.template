-- Generated by `php stone generate tenant-governance`.
--
-- Acting identity must be owner or admin. Purely functional
-- (a separate, orthogonal concept) — never gates governance, and never reads the
-- target's own governance flags. A platform MAY layer its own fixed list or
-- validation on job_role values in its own application code; the framework
-- stores it as free text.
CREATE OR REPLACE FUNCTION set_job_role(
    p_tenant_id UUID,
    p_target_identity_id UUID,
    p_job_role TEXT,
    p_acting_identity_id UUID
)
RETURNS TABLE (o_error TEXT, o_identity_id UUID, o_job_role TEXT)
LANGUAGE plpgsql AS $$
DECLARE
    v_acting_tier TEXT;
    v_target_status TEXT;
BEGIN
    v_acting_tier := _tenant_membership_tier(p_tenant_id, p_acting_identity_id);
    IF v_acting_tier IS NULL OR v_acting_tier NOT IN ('owner', 'admin') THEN
        RETURN QUERY SELECT 'not_authorized'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    SELECT status INTO v_target_status
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id
     FOR UPDATE;

    IF NOT FOUND OR v_target_status <> 'active' THEN
        RETURN QUERY SELECT 'membership_not_found'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    UPDATE tenant_memberships
       SET job_role = p_job_role, updated_at = NOW()
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    RETURN QUERY SELECT NULL::TEXT, p_target_identity_id, p_job_role;
END;
$$;

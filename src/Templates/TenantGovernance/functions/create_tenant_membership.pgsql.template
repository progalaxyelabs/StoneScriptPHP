-- Generated by `php stone generate tenant-governance`. TENANT-GOVERNANCE.md §4.
--
-- Called ONCE, at tenant provisioning — the founding row always gets BOTH
-- is_tenant_creator=true AND is_tenant_owner=true (the creator is always
-- the first owner; only is_tenant_owner may change on this row afterward,
-- is_tenant_creator never does — enforced by the trg_protect_tenant_creator
-- trigger).
--
-- Idempotent on (identity_id, tenant_id): a retried provisioning call
-- (double-click / network retry) is a no-op that returns the EXISTING row
-- unchanged in its governance flags (ON CONFLICT only bumps updated_at) —
-- it never re-asserts creator/owner=true over any later, real governance
-- change that may have happened since (an extremely unlikely but
-- deliberately safe ordering).
CREATE OR REPLACE FUNCTION create_tenant_membership(
    p_identity_id UUID,
    p_tenant_id UUID,
    p_job_role TEXT DEFAULT NULL
)
RETURNS TABLE (
    o_id UUID,
    o_identity_id UUID,
    o_tenant_id UUID,
    o_is_tenant_creator BOOLEAN,
    o_is_tenant_owner BOOLEAN,
    o_is_tenant_admin BOOLEAN,
    o_job_role TEXT,
    o_status TEXT,
    o_created_at TIMESTAMPTZ
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    INSERT INTO tenant_memberships (
        identity_id, tenant_id, is_tenant_creator, is_tenant_owner, is_tenant_admin,
        job_role, status, invited_by
    )
    VALUES (p_identity_id, p_tenant_id, true, true, false, p_job_role, 'active', NULL)
    ON CONFLICT (identity_id, tenant_id) DO UPDATE SET updated_at = NOW()
    RETURNING
        tenant_memberships.id,
        tenant_memberships.identity_id,
        tenant_memberships.tenant_id,
        tenant_memberships.is_tenant_creator,
        tenant_memberships.is_tenant_owner,
        tenant_memberships.is_tenant_admin,
        tenant_memberships.job_role::TEXT,
        tenant_memberships.status::TEXT,
        tenant_memberships.created_at;
END;
$$;

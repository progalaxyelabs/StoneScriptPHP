-- Generated by `php stone generate tenant-governance`. TENANT-GOVERNANCE.md §4.
--
-- Acting identity must be owner OR admin — ANY admin may demote ANY OTHER
-- admin (peer action, not owner-gated — TENANT-GOVERNANCE.md §1.1: "a
-- demoted admin's only recourse is asking an owner to re-promote them; the
-- system itself does not protect one admin from another"). Target must not
-- be is_tenant_owner (demote via demote_owner first). is_tenant_creator is
-- untouched regardless of outcome. Sets is_tenant_admin=false.
CREATE OR REPLACE FUNCTION demote_admin(
    p_tenant_id UUID,
    p_target_identity_id UUID,
    p_acting_identity_id UUID
)
RETURNS TABLE (o_error TEXT, o_identity_id UUID, o_is_tenant_admin BOOLEAN)
LANGUAGE plpgsql AS $$
DECLARE
    v_acting_tier TEXT;
    v_target tenant_memberships%ROWTYPE;
BEGIN
    v_acting_tier := _tenant_membership_tier(p_tenant_id, p_acting_identity_id);
    IF v_acting_tier IS NULL OR v_acting_tier NOT IN ('owner', 'admin') THEN
        RETURN QUERY SELECT 'not_authorized'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    SELECT * INTO v_target
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id
     FOR UPDATE;

    IF NOT FOUND OR v_target.status <> 'active' THEN
        RETURN QUERY SELECT 'membership_not_found'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    IF v_target.is_tenant_owner THEN
        RETURN QUERY SELECT 'target_is_owner'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    IF NOT v_target.is_tenant_admin THEN
        RETURN QUERY SELECT 'target_is_not_admin'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    UPDATE tenant_memberships
       SET is_tenant_admin = false, updated_at = NOW()
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    RETURN QUERY SELECT NULL::TEXT, p_target_identity_id, false;
END;
$$;

-- Generated by `php stone generate tenant-governance`. Internal helper —
-- TENANT-GOVERNANCE.md §1.1/§4. NOT called directly from PHP (no
-- `php stone generate model` wrapper is generated for this file); reused BY
-- the twelve public functions to avoid duplicating the "what governance
-- tier does this identity hold" lookup in each one.
--
-- Returns NULL for no active membership, else 'owner' | 'admin' | 'member'.
-- A suspended or removed membership always resolves to NULL — it never
-- counts as any governance tier, matching TENANT-GOVERNANCE.md §3.2's
-- "active owner" definition.
CREATE OR REPLACE FUNCTION _tenant_membership_tier(p_tenant_id UUID, p_identity_id UUID)
RETURNS TEXT AS $$
DECLARE
    v_is_owner BOOLEAN;
    v_is_admin BOOLEAN;
    v_status   TEXT;
BEGIN
    SELECT is_tenant_owner, is_tenant_admin, status
      INTO v_is_owner, v_is_admin, v_status
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_identity_id;

    IF NOT FOUND OR v_status <> 'active' THEN
        RETURN NULL;
    ELSIF v_is_owner THEN
        RETURN 'owner';
    ELSIF v_is_admin THEN
        RETURN 'admin';
    ELSE
        RETURN 'member';
    END IF;
END;
$$ LANGUAGE plpgsql;

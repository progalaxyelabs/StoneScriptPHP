-- Generated by `php stone generate tenant-governance`. TENANT-GOVERNANCE.md §4/§5.
--
-- Cross-tenant list of everywhere one identity holds an ACTIVE membership —
-- the data source for TenantGovernanceResolver's tenants_resolver
-- (config/auth.php). This is exactly why the ledger lives in the platform's
-- main DB rather than a per-tenant database: this query must run before any
-- specific tenant's database is selected.
CREATE OR REPLACE FUNCTION get_identity_tenant_memberships(
    p_identity_id UUID
)
RETURNS TABLE (
    o_id UUID,
    o_tenant_id UUID,
    o_is_tenant_creator BOOLEAN,
    o_is_tenant_owner BOOLEAN,
    o_is_tenant_admin BOOLEAN,
    o_job_role TEXT,
    o_status TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT
        m.id, m.tenant_id, m.is_tenant_creator, m.is_tenant_owner, m.is_tenant_admin,
        m.job_role::TEXT, m.status::TEXT
    FROM tenant_memberships m
    WHERE m.identity_id = p_identity_id
      AND m.status = 'active';
END;
$$;

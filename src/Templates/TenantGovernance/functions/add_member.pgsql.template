-- Generated by `php stone generate tenant-governance`.
--
-- Adds a new, non-creator member — the primitive an invite-accept flow
-- calls. Always is_tenant_creator=false; is_tenant_owner is never settable
-- here (owner status only ever arrives via promote_to_owner — no function
-- skips a tier).
--
-- Upserts: if (identity_id, tenant_id) already exists with status='removed'
-- (a previously-offboarded member re-invited later), reactivates that row
-- instead of violating the unique constraint or creating a second row for
-- the same pair. An existing row that is NOT 'removed' (already active or
-- suspended) is a genuine duplicate-add attempt, not a reactivation —
-- returns a typed error rather than silently overwriting an existing
-- membership's standing.
CREATE OR REPLACE FUNCTION add_member(
    p_tenant_id UUID,
    p_identity_id UUID,
    p_invited_by UUID,
    p_is_tenant_admin BOOLEAN DEFAULT false,
    p_job_role TEXT DEFAULT NULL
)
RETURNS TABLE (
    o_error TEXT,
    o_id UUID,
    o_identity_id UUID,
    o_tenant_id UUID,
    o_is_tenant_admin BOOLEAN,
    o_job_role TEXT,
    o_status TEXT
)
LANGUAGE plpgsql AS $$
DECLARE
    v_existing_status TEXT;
    v_row tenant_memberships%ROWTYPE;
BEGIN
    SELECT status INTO v_existing_status
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_identity_id
     FOR UPDATE;

    IF FOUND AND v_existing_status <> 'removed' THEN
        RETURN QUERY SELECT 'already_a_member'::TEXT, NULL::UUID, NULL::UUID, NULL::UUID, NULL::BOOLEAN, NULL::TEXT, NULL::TEXT;
        RETURN;
    END IF;

    IF FOUND THEN
        UPDATE tenant_memberships
           SET is_tenant_admin = p_is_tenant_admin,
               job_role        = p_job_role,
               status          = 'active',
               invited_by      = p_invited_by,
               updated_at      = NOW()
         WHERE tenant_id = p_tenant_id AND identity_id = p_identity_id
        RETURNING * INTO v_row;
    ELSE
        INSERT INTO tenant_memberships (
            identity_id, tenant_id, is_tenant_creator, is_tenant_owner, is_tenant_admin,
            job_role, status, invited_by
        )
        VALUES (p_identity_id, p_tenant_id, false, false, p_is_tenant_admin, p_job_role, 'active', p_invited_by)
        RETURNING * INTO v_row;
    END IF;

    RETURN QUERY SELECT
        NULL::TEXT, v_row.id, v_row.identity_id, v_row.tenant_id, v_row.is_tenant_admin, v_row.job_role::TEXT, v_row.status::TEXT;
END;
$$;

-- Generated by `php stone generate tenant-governance`. TENANT-GOVERNANCE.md §4.
--
-- Acting identity must currently be owner. Target must currently be admin
-- (bottom-up only — no function skips a tier: member -> admin -> owner).
-- Sets is_tenant_owner=true. Multiple simultaneous owners are allowed
-- (TENANT-GOVERNANCE.md §1.1 — "many allowed, e.g. business partners").
CREATE OR REPLACE FUNCTION promote_to_owner(
    p_tenant_id UUID,
    p_target_identity_id UUID,
    p_acting_identity_id UUID
)
RETURNS TABLE (o_error TEXT, o_identity_id UUID, o_is_tenant_owner BOOLEAN)
LANGUAGE plpgsql AS $$
DECLARE
    v_acting_tier TEXT;
    v_target tenant_memberships%ROWTYPE;
BEGIN
    v_acting_tier := _tenant_membership_tier(p_tenant_id, p_acting_identity_id);
    IF v_acting_tier IS DISTINCT FROM 'owner' THEN
        RETURN QUERY SELECT 'not_authorized'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    SELECT * INTO v_target
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id
     FOR UPDATE;

    IF NOT FOUND OR v_target.status <> 'active' THEN
        RETURN QUERY SELECT 'membership_not_found'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    IF v_target.is_tenant_owner THEN
        RETURN QUERY SELECT 'target_already_owner'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    IF NOT v_target.is_tenant_admin THEN
        RETURN QUERY SELECT 'target_not_admin'::TEXT, NULL::UUID, NULL::BOOLEAN;
        RETURN;
    END IF;

    UPDATE tenant_memberships
       SET is_tenant_owner = true, updated_at = NOW()
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    RETURN QUERY SELECT NULL::TEXT, p_target_identity_id, true;
END;
$$;

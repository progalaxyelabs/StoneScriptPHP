-- Generated by `php stone generate tenant-governance`. TENANT-GOVERNANCE.md §4/§3.2.
--
-- General active <-> suspended toggle (mirrors auth's own
-- setMembershipStatus naming for a familiar shape — entirely local/
-- platform-side, no auth call). Acting identity must be owner or admin.
-- Applies to ANYONE including the creator — the creator can be suspended,
-- same as any member (is_tenant_creator is a provenance marker, not a
-- permission; suspension is not a governance edit). Refuses
-- (cannot_suspend_last_owner) if the target is the sole remaining active
-- owner and the new status is 'suspended'.
--
-- Does NOT accept p_status='removed' — that transition only happens
-- through remove_member(), which has its own, stricter rules (creator
-- protection, clearing governance flags on exit).
CREATE OR REPLACE FUNCTION set_membership_status(
    p_tenant_id UUID,
    p_target_identity_id UUID,
    p_status TEXT,
    p_acting_identity_id UUID
)
RETURNS TABLE (o_error TEXT, o_identity_id UUID, o_status TEXT)
LANGUAGE plpgsql AS $$
DECLARE
    v_acting_tier TEXT;
    v_target tenant_memberships%ROWTYPE;
    v_active_owner_count INTEGER;
BEGIN
    IF p_status NOT IN ('active', 'suspended') THEN
        RETURN QUERY SELECT 'invalid_status'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    v_acting_tier := _tenant_membership_tier(p_tenant_id, p_acting_identity_id);
    IF v_acting_tier IS NULL OR v_acting_tier NOT IN ('owner', 'admin') THEN
        RETURN QUERY SELECT 'not_authorized'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    -- Lock this tenant's active-owner rows up front (see demote_owner()'s
    -- comment for why) — cheap no-op when the target isn't an owner at all.
    PERFORM 1 FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND is_tenant_owner AND status = 'active'
     FOR UPDATE;

    SELECT * INTO v_target
      FROM tenant_memberships
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    IF NOT FOUND OR v_target.status = 'removed' THEN
        RETURN QUERY SELECT 'membership_not_found'::TEXT, NULL::UUID, NULL::TEXT;
        RETURN;
    END IF;

    IF p_status = 'suspended' AND v_target.is_tenant_owner THEN
        SELECT count(*) INTO v_active_owner_count
          FROM tenant_memberships
         WHERE tenant_id = p_tenant_id AND is_tenant_owner AND status = 'active';

        IF v_active_owner_count <= 1 THEN
            RETURN QUERY SELECT 'cannot_suspend_last_owner'::TEXT, NULL::UUID, NULL::TEXT;
            RETURN;
        END IF;
    END IF;

    UPDATE tenant_memberships
       SET status = p_status, updated_at = NOW()
     WHERE tenant_id = p_tenant_id AND identity_id = p_target_identity_id;

    RETURN QUERY SELECT NULL::TEXT, p_target_identity_id, p_status;
END;
$$;

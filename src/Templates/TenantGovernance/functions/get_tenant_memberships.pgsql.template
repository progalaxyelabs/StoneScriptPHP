-- Generated by `php stone generate tenant-governance`. TENANT-GOVERNANCE.md §4.
--
-- Lists every membership row + governance flags + job_role for one tenant —
-- the data source for a settings/members-management page. No in-SQL
-- authorization gate (mirrors this framework's own
-- get_platform_invitation_by_token_hash precedent) — the calling route
-- decides who may view this listing. Callers filter status themselves
-- (e.g. hide 'removed' from the default view).
CREATE OR REPLACE FUNCTION get_tenant_memberships(
    p_tenant_id UUID
)
RETURNS TABLE (
    o_id UUID,
    o_identity_id UUID,
    o_is_tenant_creator BOOLEAN,
    o_is_tenant_owner BOOLEAN,
    o_is_tenant_admin BOOLEAN,
    o_job_role TEXT,
    o_status TEXT,
    o_invited_by UUID,
    o_created_at TIMESTAMPTZ,
    o_updated_at TIMESTAMPTZ
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT
        m.id, m.identity_id, m.is_tenant_creator, m.is_tenant_owner, m.is_tenant_admin,
        m.job_role::TEXT, m.status::TEXT, m.invited_by, m.created_at, m.updated_at
    FROM tenant_memberships m
    WHERE m.tenant_id = p_tenant_id
    ORDER BY m.created_at ASC;
END;
$$;

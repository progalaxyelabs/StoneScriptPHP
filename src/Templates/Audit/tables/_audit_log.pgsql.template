-- Immutable, append-only audit log.
--
-- Generated by `php stone generate audit`. Lives in THIS database (main or
-- tenant — the generator can be run against either) alongside the tables it
-- watches. One `_audit_log` table per database, fed by AFTER-row triggers
-- attached to the tables you name when running the generator (default:
-- identities, tenants, tenant_memberships).
--
-- Declarative definition (gateway schema-sync source of truth) — mirrors
-- migrations/*_create_audit_log.pgsql's CREATE TABLE exactly. The REVOKE
-- that makes this table append-only, and the CREATE TRIGGER statements that
-- attach capture to specific tables, live in the migration only (REVOKE
-- needs a live connection role to target; CREATE TRIGGER needs its target
-- tables to physically exist) — a declarative table file alone cannot
-- guarantee either at gateway schema-sync time.
--
-- subject_id is TEXT with NO foreign key on purpose: an audit row must
-- outlive the row it describes (soft-delete purge, `php stone generate
-- soft-delete`, physically deletes the source row after 7 days — the DELETE
-- itself fires this table's trigger one last time, and THAT row must never
-- be able to fail or cascade-delete because the subject is gone).
CREATE TABLE IF NOT EXISTS _audit_log (
    audit_id        BIGSERIAL PRIMARY KEY,
    occurred_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    table_name      TEXT NOT NULL,
    operation       TEXT NOT NULL CHECK (operation IN ('INSERT', 'UPDATE', 'DELETE')),

    -- Best-effort extraction of the mutated row's identifier (tried in order:
    -- id, uuid, identity_id, tenant_id, workspace_id — see
    -- _audit_capture_row() below). NULL only if the audited table's primary
    -- key uses none of those names — extend the trigger function by hand if
    -- so; this is a known, documented limitation, not a silent gap.
    subject_id      TEXT,

    -- "Who". Set via set_config('app.actor_id', <id>, true) at the top of
    -- any mutating SQL function that has an acting identity available —
    -- generate-model.php-produced wrappers don't do this for you; add the
    -- line yourself in each mutating function (see the generator's
    -- printed next-steps). Left unset (cron jobs, raw psql, gateway
    -- migrate, admin tooling) → actor_source='system', which is the honest
    -- answer, not a gap.
    actor_id        TEXT,
    actor_source    TEXT NOT NULL DEFAULT 'system' CHECK (actor_source IN ('user', 'system')),

    before_row      JSONB,
    after_row       JSONB
);

CREATE INDEX IF NOT EXISTS idx_audit_log_table_subject ON _audit_log(table_name, subject_id);
CREATE INDEX IF NOT EXISTS idx_audit_log_occurred_at    ON _audit_log(occurred_at);

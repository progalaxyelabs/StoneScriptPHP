DO $$
BEGIN
    IF to_regclass('__TABLE__') IS NOT NULL THEN
        DROP TRIGGER IF EXISTS trg_audit___TABLE__ ON __TABLE__;
        CREATE TRIGGER trg_audit___TABLE__
            AFTER INSERT OR UPDATE OR DELETE ON __TABLE__
            FOR EACH ROW EXECUTE FUNCTION _audit_capture_row();

        DROP TRIGGER IF EXISTS trg_audit_truncate___TABLE__ ON __TABLE__;
        CREATE TRIGGER trg_audit_truncate___TABLE__
            AFTER TRUNCATE ON __TABLE__
            FOR EACH STATEMENT EXECUTE FUNCTION _audit_capture_truncate();

        -- TRUNCATE bypasses row triggers entirely (see
        -- _audit_capture_truncate()'s comment) — the statement trigger above
        -- logs it IF it happens. Denying TRUNCATE to the runtime role itself
        -- is now the GATEWAY's job (role-split REVOKE/GRANT, see the header
        -- comment above) when the role-split is enabled — a `REVOKE ... FROM
        -- current_user` here would self-revoke the single connecting role on
        -- a flag-off fleet, which is why it has been removed from this
        -- per-table block.
    ELSE
        -- Per the gateway's real deploy order (extensions -> types ->
        -- TABLES -> FUNCTIONS -> MIGRATIONS -> verify_schema, every
        -- /v2/migrate run — not just the first), this table normally
        -- already exists here if it's declared declaratively (the standard
        -- way this framework defines a table), so this branch should be
        -- rare. NON-silent on purpose: a plain to_regclass()-guarded skip
        -- with no warning would let this table's audit coverage silently
        -- never happen, forever (the gateway's migration runner is
        -- filename-deduped/forward-only — it never retries this exact
        -- migration file even after the table shows up later). RAISE
        -- WARNING surfaces that instead of hiding it behind a green log,
        -- without hard-failing the whole migration (this table may
        -- legitimately not exist on every platform/database that uses this
        -- generator's default --tables list, e.g. tenant_memberships
        -- without `php stone generate tenant-governance`).
        RAISE WARNING 'audit: table "%" does not exist — capture trigger NOT attached. If this table SHOULD exist, create it and re-run this migration (or a follow-on one with the same attach block) so this warning goes away.', '__TABLE__';
    END IF;
END $$;

-- Immutable, append-only audit log.
--
-- Generated by `php stone generate audit`. Non-destructive, idempotent DDL
-- only — safe to re-run on any database at any state (this framework's
-- migration-safety rule: additive schema changes only, IF NOT EXISTS guards
-- throughout, nothing that removes data).
--
-- CREATE TABLE is identical to src/postgresql/tables/_audit_log.pgsql (or
-- the nested main-DB equivalent) — the gateway's declarative schema-sync
-- source of truth — kept in sync by hand; this file is what actually runs
-- against an existing database.
CREATE TABLE IF NOT EXISTS _audit_log (
    audit_id        BIGSERIAL PRIMARY KEY,
    occurred_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    table_name      TEXT NOT NULL,
    operation       TEXT NOT NULL CHECK (operation IN ('INSERT', 'UPDATE', 'DELETE')),
    subject_id      TEXT,
    actor_id        TEXT,
    actor_source    TEXT NOT NULL DEFAULT 'system' CHECK (actor_source IN ('user', 'system')),
    before_row      JSONB,
    after_row       JSONB
);

CREATE INDEX IF NOT EXISTS idx_audit_log_table_subject ON _audit_log(table_name, subject_id);
CREATE INDEX IF NOT EXISTS idx_audit_log_occurred_at    ON _audit_log(occurred_at);

-- Append-only enforcement. Runs every time this migration re-runs (REVOKE of
-- an already-revoked privilege is a harmless no-op) — targets the role that
-- is ACTUALLY running this migration (current_user), which in this
-- framework's gateway-only architecture is the same role the app uses at
-- runtime (there is no separate migration-user vs runtime-user split). If a
-- given deployment's role model differs, adjust the target role by hand —
-- this is a real, documented operational assumption, not a silent one (see
-- the generator's --help output).
--
-- INSERT is deliberately left granted (the trigger's own writes need it, and
-- so would any legitimate direct audit-row insert); only UPDATE, DELETE,
-- TRUNCATE are revoked, which is what makes existing rows immutable.
DO $$
DECLARE
    v_role TEXT := current_user;
BEGIN
    EXECUTE format('REVOKE UPDATE, DELETE, TRUNCATE ON _audit_log FROM %I', v_role);
END $$;

-- Attach capture to each audited table. The underlying function
-- (_audit_capture_row) is deployed by the gateway's FUNCTIONS step, which
-- always runs before migrations — see this framework's documented gateway
-- migration order — so it already exists by the time this statement runs.
-- CREATE TRIGGER itself, unlike CREATE FUNCTION, requires the target table
-- to physically exist; each block below is guarded with to_regclass() so a
-- table that hasn't been created yet on THIS database is silently skipped
-- rather than failing the whole migration — re-run `php stone migrate up`
-- (or the gateway migrate equivalent) after that table lands and this
-- migration will attach the trigger to it then (CREATE TABLE/TRIGGER
-- statements above and below are all idempotent).
__AUDITED_TABLE_TRIGGERS__

-- Generated by `php stone generate audit`. Internal AFTER-STATEMENT trigger
-- function — companion to _audit_capture_row(). AFTER-ROW triggers never
-- fire on TRUNCATE (a PostgreSQL limitation: TRUNCATE bypasses per-row
-- processing entirely), so a table with ONLY the row trigger attached would
-- let TRUNCATE erase every row with zero audit trail. This statement-level
-- trigger closes that gap: it can't capture individual before-rows (there
-- aren't any by the time a statement trigger fires), but it DOES record
-- that the whole table was wiped, when, and by whom. Combined with the
-- migration's REVOKE TRUNCATE on the audited base table (see
-- migrations/*_create_audit_log.pgsql), TRUNCATE is both rare (the app role
-- can't issue it) and, if it ever does happen (elevated role, admin
-- override), logged.
CREATE OR REPLACE FUNCTION _audit_capture_truncate()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
    v_actor TEXT;
BEGIN
    v_actor := NULLIF(current_setting('app.actor_id', true), '');

    INSERT INTO _audit_log (table_name, operation, subject_id, actor_id, actor_source, before_row, after_row)
    VALUES (
        TG_TABLE_NAME,
        'TRUNCATE',
        NULL,
        v_actor,
        CASE WHEN v_actor IS NULL THEN 'system' ELSE 'user' END,
        NULL,
        NULL
    );

    RETURN NULL; -- ignored for AFTER STATEMENT triggers
END;
$$;

-- Generated by `php stone generate audit`. Internal AFTER-row trigger
-- function. NOT called directly from PHP (no `php stone generate model`
-- wrapper is generated for this file); it is attached to each audited table
-- by the migration's CREATE TRIGGER statements
-- (migrations/*_create_audit_log.pgsql), one trigger per table, all sharing
-- this single function.
--
-- Two-role model (stonescriptdb-gateway's gated audit-owner role-split, see
-- `src/audit_provision/mod.rs`): when enabled, this function — along with
-- `_audit_log` and the audited base tables — is owned by a privileged NOLOGIN
-- `{platform}_audit_owner` role that the runtime role is NOT a member of and
-- holds ZERO grants on `_audit_log`. SECURITY DEFINER is what makes this
-- function's own INSERT work in that world: it executes as its OWNER
-- (audit_owner), not as the caller, so the runtime role never needs (and
-- never gets) any privilege on `_audit_log` at all — there is no REVOKE to
-- rely on, no privilege for a compromised runtime credential to have in the
-- first place. The locked-down search_path prevents a runtime role from
-- shadowing pg_catalog/public objects this function calls.
--
-- On a fleet WITHOUT the role-split enabled (flag off), there is only the one
-- connecting role, SECURITY DEFINER is a no-op (invoker == owner), and
-- `_audit_log` is only tamper-EVIDENT, same as every other table on that
-- fleet — documented, not silent (see the generator's --help output).
CREATE OR REPLACE FUNCTION _audit_capture_row()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
    v_row_json    JSONB;
    v_subject_id  TEXT;
    v_actor       TEXT;
BEGIN
    v_row_json := to_jsonb(COALESCE(NEW, OLD));

    -- Best-effort PK extraction — see the _audit_log.subject_id comment.
    v_subject_id := COALESCE(
        v_row_json ->> 'id',
        v_row_json ->> 'uuid',
        v_row_json ->> 'identity_id',
        v_row_json ->> 'tenant_id',
        v_row_json ->> 'workspace_id'
    );

    v_actor := NULLIF(current_setting('app.actor_id', true), '');

    INSERT INTO _audit_log (
        table_name, operation, subject_id, actor_id, actor_source, before_row, after_row
    )
    VALUES (
        TG_TABLE_NAME,
        TG_OP,
        v_subject_id,
        v_actor,
        CASE WHEN v_actor IS NULL THEN 'system' ELSE 'user' END,
        CASE WHEN TG_OP IN ('UPDATE', 'DELETE') THEN to_jsonb(OLD) ELSE NULL END,
        CASE WHEN TG_OP IN ('INSERT', 'UPDATE') THEN to_jsonb(NEW) ELSE NULL END
    );

    RETURN COALESCE(NEW, OLD);
END;
$$;

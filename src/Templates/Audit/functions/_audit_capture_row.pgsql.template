-- Generated by `php stone generate audit`. Internal AFTER-row trigger
-- function. NOT called directly from PHP (no `php stone generate model`
-- wrapper is generated for this file); it is attached to each audited table
-- by the migration's CREATE TRIGGER statements
-- (migrations/*_create_audit_log.pgsql), one trigger per table, all sharing
-- this single function.
--
-- What actually makes this append-only in THIS framework's typical
-- single-role gateway deployment (one connecting role per database, no
-- separate migration-user vs runtime-user split) is simpler than SECURITY
-- DEFINER: the migration REVOKEs UPDATE, DELETE, TRUNCATE ON _audit_log
-- FROM that one role while leaving INSERT granted — so this trigger's own
-- INSERT keeps working (it was never revoked) and any ordinary application
-- code (hand-written SQL function, route, ORM-style call, or a raw UPDATE/
-- DELETE against _audit_log itself) is rejected outright. SECURITY DEFINER
-- + the locked-down search_path are kept anyway as harmless defense in
-- depth for any deployment that DOES provision a separate, more-privileged
-- owner role — but do not rely on SECURITY DEFINER alone to bypass a
-- REVOKE against its own owning role; it cannot (Postgres privilege checks
-- apply to the owner too — SECURITY DEFINER only changes anything when
-- invoker and owner are genuinely different roles). Neither mechanism
-- defends against a role with GRANT-back privileges deliberately undoing
-- the REVOKE — that is a deployment/ops control, not something SQL alone
-- can prevent, and is documented as an operational risk (see the
-- generator's --help output and README).
CREATE OR REPLACE FUNCTION _audit_capture_row()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
    v_row_json    JSONB;
    v_subject_id  TEXT;
    v_actor       TEXT;
BEGIN
    v_row_json := to_jsonb(COALESCE(NEW, OLD));

    -- Best-effort PK extraction — see the _audit_log.subject_id comment.
    v_subject_id := COALESCE(
        v_row_json ->> 'id',
        v_row_json ->> 'uuid',
        v_row_json ->> 'identity_id',
        v_row_json ->> 'tenant_id',
        v_row_json ->> 'workspace_id'
    );

    v_actor := NULLIF(current_setting('app.actor_id', true), '');

    INSERT INTO _audit_log (
        table_name, operation, subject_id, actor_id, actor_source, before_row, after_row
    )
    VALUES (
        TG_TABLE_NAME,
        TG_OP,
        v_subject_id,
        v_actor,
        CASE WHEN v_actor IS NULL THEN 'system' ELSE 'user' END,
        CASE WHEN TG_OP IN ('UPDATE', 'DELETE') THEN to_jsonb(OLD) ELSE NULL END,
        CASE WHEN TG_OP IN ('INSERT', 'UPDATE') THEN to_jsonb(NEW) ELSE NULL END
    );

    RETURN COALESCE(NEW, OLD);
END;
$$;

declare(strict_types=1);

/**
 * Platform-wide privilege seed. Generated by `php stone generate tenancy`; edit it freely.
 *
 * Which privileges each role has. It is written into EVERY tenant database when the tenant is provisioned
 * (user_role_privileges), so a role means the same in every tenant and a returning user's roles resolve to real

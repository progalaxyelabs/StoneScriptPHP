-- Tenant database: expand an EXISTING `users` table to the tenancy v2 shape. Generated by
-- `php stone generate tenancy` when your tenant schema already defines a `users` table (the generator will not
-- write a second definition). Forward-only and idempotent: additive DDL with IF NOT EXISTS guards, nothing is
-- dropped, truncated or retyped, and running it again changes nothing.
--
-- Gateway order: functions first, then this migration, then declarative table sync. The tenant functions
-- (tenant_user_upsert and friends) are plpgsql, so they are created before the new columns exist.
--
-- What it does:
--   * identity_id UUID           added; BACKFILLED FROM id where id is the identity (see the UPDATE below: if your
--                                 users.id is NOT the auth identity, replace that statement with your own mapping
--                                 before running). Rows it cannot fill stay NULL.
--   * status TEXT DEFAULT 'active'  added (existing rows become 'active'); display_name, created_at, updated_at added
--                                 when missing.
--   * UNIQUE (identity_id)       added AFTER a pre-check: if two rows share an identity_id the migration RAISES,
--                                 naming them, and nothing is tightened. Fix the data and run it again.
-- Mirror the new columns in your own users declaration so table sync keeps them.
DO $$
DECLARE
    v_dups TEXT;
    v_id_type TEXT;
    v_had_status BOOLEAN;
BEGIN
    IF to_regclass('users') IS NULL THEN
        RETURN;
    END IF;

    SELECT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = 'users' AND column_name = 'status'
    ) INTO v_had_status;

    ALTER TABLE users ADD COLUMN IF NOT EXISTS identity_id UUID;
    ALTER TABLE users ADD COLUMN IF NOT EXISTS display_name TEXT;
    ALTER TABLE users ADD COLUMN IF NOT EXISTS status TEXT NOT NULL DEFAULT 'active';
    ALTER TABLE users ADD COLUMN IF NOT EXISTS created_at TIMESTAMPTZ NOT NULL DEFAULT NOW();
    ALTER TABLE users ADD COLUMN IF NOT EXISTS updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW();

    -- Vocabulary guard only for the column this migration created (a status column you already had keeps its values).
    IF NOT v_had_status AND NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'users_status_check' AND conrelid = 'users'::regclass) THEN
        ALTER TABLE users ADD CONSTRAINT users_status_check CHECK (status IN ('active', 'suspended', 'removed'));
    END IF;

    -- Backfill: id is the identity. Only for rows still empty, and only when id is a uuid.
    SELECT data_type INTO v_id_type FROM information_schema.columns
    WHERE table_schema = current_schema() AND table_name = 'users' AND column_name = 'id';
    IF v_id_type = 'uuid' THEN
        EXECUTE 'UPDATE users SET identity_id = id WHERE identity_id IS NULL';
    ELSE
        RAISE NOTICE 'users.id is % (not uuid): identity_id was not backfilled; fill it with your own mapping', v_id_type;
    END IF;

    -- One user per identity: refuse loudly, naming the duplicates, before the constraint is added.
    SELECT string_agg(d.identity_id::TEXT || ' x' || d.n, ', ') INTO v_dups
    FROM (
        SELECT identity_id, count(*) AS n FROM users WHERE identity_id IS NOT NULL
        GROUP BY identity_id HAVING count(*) > 1 ORDER BY count(*) DESC LIMIT 20
    ) d;
    IF v_dups IS NOT NULL THEN
        RAISE EXCEPTION 'tenancy_v2: duplicate users.identity_id values, resolve before migrating: %', v_dups;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'users_identity_id_key' AND conrelid = 'users'::regclass) THEN
        ALTER TABLE users ADD CONSTRAINT users_identity_id_key UNIQUE (identity_id);
    END IF;
END;
$$;

-- Tenant database: the roles a user holds in this tenant. Generated by `php stone generate tenancy`.
-- role_code is a platform vocabulary (owner, admin, ...). A role with no user_role_privileges rows grants nothing.
CREATE TABLE IF NOT EXISTS user_roles (
    user_id             UUID NOT NULL REFERENCES users (id) ON DELETE NO ACTION,
    role_code           TEXT NOT NULL,
    assigned_by_user_id UUID REFERENCES users (id) ON DELETE NO ACTION,
    created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT user_roles_user_role_key UNIQUE (user_id, role_code)
);

CREATE INDEX IF NOT EXISTS idx_user_roles_role ON user_roles (role_code);

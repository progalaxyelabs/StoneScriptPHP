-- Tenant database: what each role may do. Generated by `php stone generate tenancy`.
-- Seed these rows per platform (for example from a route-to-privilege map). An unknown role, or a role with
-- no rows here, grants NOTHING: there is no default and no fallback role.
CREATE TABLE IF NOT EXISTS user_role_privileges (
    role_code       TEXT NOT NULL,
    privilege_code  TEXT NOT NULL,
    CONSTRAINT user_role_privileges_role_privilege_key UNIQUE (role_code, privilege_code)
);

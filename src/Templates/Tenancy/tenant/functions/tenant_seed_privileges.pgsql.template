-- Generated by `php stone generate tenancy`. Tenant database: write the platform-wide privilege seed
-- (role -> privileges) into user_role_privileges and return how many privileges p_check_role has afterwards.
--
-- p_grants is a JSON object {"owner": ["tenant.manage", ...], "cashier": [...]}. Idempotent: rows already present
-- are kept, none are removed. Role and privilege codes are validated. The caller (provisioning) refuses to finish a
-- tenant whose owner role has no privileges.
CREATE OR REPLACE FUNCTION tenant_seed_privileges(
    p_grants TEXT,
    p_check_role TEXT
)
RETURNS TABLE (
    o_privilege_count INTEGER
)
LANGUAGE plpgsql AS $$
DECLARE
    v_grants JSONB;
    v_role TEXT;
    v_priv TEXT;
BEGIN
    v_grants := COALESCE(NULLIF(BTRIM(p_grants), ''), '{}')::JSONB;
    IF jsonb_typeof(v_grants) <> 'object' THEN
        RAISE EXCEPTION 'invalid_privilege_seed: expected a JSON object';
    END IF;

    FOR v_role IN SELECT jsonb_object_keys(v_grants) LOOP
        IF v_role !~ '^[a-z][a-z0-9_]{0,63}$' THEN
            RAISE EXCEPTION 'invalid_privilege_seed: bad role code';
        END IF;
        IF jsonb_typeof(v_grants -> v_role) <> 'array' THEN
            RAISE EXCEPTION 'invalid_privilege_seed: privileges must be an array';
        END IF;
        FOR v_priv IN SELECT jsonb_array_elements_text(v_grants -> v_role) LOOP
            IF v_priv !~ '^[a-z][a-z0-9_.:-]{0,99}$' THEN
                RAISE EXCEPTION 'invalid_privilege_seed: bad privilege code';
            END IF;
            INSERT INTO user_role_privileges (role_code, privilege_code)
            VALUES (v_role, v_priv)
            ON CONFLICT (role_code, privilege_code) DO NOTHING;
        END LOOP;
    END LOOP;

    RETURN QUERY
    SELECT count(*)::INTEGER FROM user_role_privileges p WHERE p.role_code = p_check_role;
END;
$$;

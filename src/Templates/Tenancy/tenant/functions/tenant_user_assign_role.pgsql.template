-- Generated by `php stone generate tenancy`. Tenant database: give a user a role. Idempotent on
-- (user_id, role_code). The role code must be a lower-case code; whether it grants anything is decided
-- by user_role_privileges (an unknown role grants nothing).
CREATE OR REPLACE FUNCTION tenant_user_assign_role(
    p_user_id UUID,
    p_role_code TEXT,
    p_assigned_by_user_id UUID DEFAULT NULL
)
RETURNS VOID
LANGUAGE plpgsql AS $$
BEGIN
    IF p_role_code IS NULL OR p_role_code !~ '^[a-z][a-z0-9_]{0,63}$' THEN
        RAISE EXCEPTION 'invalid_role_code';
    END IF;

    INSERT INTO user_roles (user_id, role_code, assigned_by_user_id)
    VALUES (p_user_id, p_role_code, p_assigned_by_user_id)
    ON CONFLICT (user_id, role_code) DO NOTHING;
END;
$$;

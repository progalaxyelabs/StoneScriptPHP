-- Generated by `php stone generate tenancy`. Tenant database: ensure a `users` row exists for an identity.
-- Idempotent on identity_id; returns the user id. A non-null display name refreshes the stored one.
--
-- The new row's id IS the identity id (id = identity_id), so this works on a users table whose id has no default
-- (an existing table where users.id is the identity) as well as on the generated one. An existing row keeps its id.
CREATE OR REPLACE FUNCTION tenant_user_upsert(
    p_identity_id UUID,
    p_display_name TEXT DEFAULT NULL
)
RETURNS TABLE (
    o_id UUID
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    INSERT INTO users (id, identity_id, display_name)
    VALUES (p_identity_id, p_identity_id, p_display_name)
    ON CONFLICT (identity_id) DO UPDATE SET
        display_name = COALESCE(EXCLUDED.display_name, users.display_name),
        updated_at = NOW()
    RETURNING users.id;
END;
$$;

-- Generated by `php stone generate tenancy`. Tenant database: the roles an ACTIVE user holds, each with the
-- privileges seeded for that role. A role with no privilege rows still appears once with a NULL privilege so the
-- caller can tell "held but unknown" from "not held"; it grants nothing.
CREATE OR REPLACE FUNCTION tenant_get_identity_role_privileges(
    p_identity_id UUID
)
RETURNS TABLE (
    o_role_code TEXT,
    o_privilege_code TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT r.role_code::TEXT, p.privilege_code::TEXT
    FROM users u
    JOIN user_roles r ON r.user_id = u.id
    LEFT JOIN user_role_privileges p ON p.role_code = r.role_code
    WHERE u.identity_id = p_identity_id
      AND u.status = 'active'
    ORDER BY r.role_code, p.privilege_code;
END;
$$;

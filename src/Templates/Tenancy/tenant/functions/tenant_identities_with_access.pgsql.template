-- Generated by `php stone generate tenancy`. Tenant database, READ-ONLY: the identities that have an ACTIVE `users`
-- row holding at least one role that has at least one privilege (a "known role"). Everyone else cannot select this
-- tenant. Used by `php stone tenancy:preflight` (empty user_roles before a platform's role move shows up here).
CREATE OR REPLACE FUNCTION tenant_identities_with_access()
RETURNS TABLE (
    o_identity_id UUID
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT DISTINCT u.identity_id
    FROM users u
    JOIN user_roles r ON r.user_id = u.id
    WHERE u.status = 'active'
      AND u.identity_id IS NOT NULL
      AND EXISTS (SELECT 1 FROM user_role_privileges p WHERE p.role_code = r.role_code)
    ORDER BY u.identity_id;
END;
$$;

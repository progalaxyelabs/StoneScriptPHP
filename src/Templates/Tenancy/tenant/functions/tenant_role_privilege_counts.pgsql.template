-- Generated by `php stone generate tenancy`. Tenant database, READ-ONLY: every role that is held by a user or has
-- privileges, with how many privileges it has and how many users hold it. A role with users but ZERO privileges
-- grants nothing: `php stone tenancy:preflight` fails on it before LEGACY_TENANCY is set to false.
CREATE OR REPLACE FUNCTION tenant_role_privilege_counts()
RETURNS TABLE (
    o_role_code TEXT,
    o_privilege_count INTEGER,
    o_user_count INTEGER
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT r.role_code::TEXT,
           (SELECT count(*)::INTEGER FROM user_role_privileges p WHERE p.role_code = r.role_code),
           (SELECT count(DISTINCT ur.user_id)::INTEGER FROM user_roles ur WHERE ur.role_code = r.role_code)
    FROM (
        SELECT role_code FROM user_roles
        UNION
        SELECT role_code FROM user_role_privileges
    ) r
    ORDER BY r.role_code;
END;
$$;

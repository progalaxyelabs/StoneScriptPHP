-- Generated by `php stone generate tenancy`. Tenant database, READ-ONLY: which (role, privilege) pairs of the
-- platform privilege seed are NOT yet in user_role_privileges. p_grants is the same JSON object that
-- tenant_seed_privileges takes. Used by `php stone tenancy:seed-privileges --dry-run`.
CREATE OR REPLACE FUNCTION tenant_missing_privileges(
    p_grants TEXT
)
RETURNS TABLE (
    o_role_code TEXT,
    o_privilege_code TEXT
)
LANGUAGE plpgsql AS $$
DECLARE
    v_grants JSONB;
    v_role TEXT;
    v_priv TEXT;
BEGIN
    v_grants := COALESCE(NULLIF(BTRIM(p_grants), ''), '{}')::JSONB;
    IF jsonb_typeof(v_grants) <> 'object' THEN
        RAISE EXCEPTION 'invalid_privilege_seed: expected a JSON object';
    END IF;

    FOR v_role IN SELECT jsonb_object_keys(v_grants) LOOP
        IF v_role !~ '^[a-z][a-z0-9_]{0,63}$' OR jsonb_typeof(v_grants -> v_role) <> 'array' THEN
            RAISE EXCEPTION 'invalid_privilege_seed: bad role';
        END IF;
        FOR v_priv IN SELECT jsonb_array_elements_text(v_grants -> v_role) LOOP
            IF v_priv !~ '^[a-z][a-z0-9_.:-]{0,99}$' THEN
                RAISE EXCEPTION 'invalid_privilege_seed: bad privilege code';
            END IF;
            IF NOT EXISTS (SELECT 1 FROM user_role_privileges p WHERE p.role_code = v_role AND p.privilege_code = v_priv) THEN
                o_role_code := v_role;
                o_privilege_code := v_priv;
                RETURN NEXT;
            END IF;
        END LOOP;
    END LOOP;
END;
$$;

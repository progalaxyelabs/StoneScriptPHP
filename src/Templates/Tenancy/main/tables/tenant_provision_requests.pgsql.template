-- Idempotency ledger for STANDALONE (builtin) platforms: which ids an idempotency key reserved, so a retry
-- resumes the SAME tenant. Generated by `php stone generate tenancy --builtin`. (In external mode the
-- auth service keeps this.)
CREATE TABLE IF NOT EXISTS tenant_provision_requests (
    idempotency_key TEXT PRIMARY KEY,
    identity_id     UUID NOT NULL,
    tenant_id       UUID NOT NULL,
    membership_id   UUID NOT NULL,
    tenant_db_name  TEXT NOT NULL DEFAULT '',
    created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

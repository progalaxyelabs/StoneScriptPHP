-- Tenants, core columns. Generated by `php stone generate tenancy` ONLY when the project
-- has no tenants table yet. A platform that already has one keeps it and adds the same core columns
-- (the generated migration adds them to the live table; mirror them in your own tenants.pgsql):
--
--   uuid (PK, = the authority's platform tenant id), name, slug (optional), tenant_db_name (UNIQUE),
--   tenant_provisioning_status, created_by_identity_id, created_at, updated_at, provisioned_at
--
-- Platform business columns (address, tax ids, business type, ...) are added by the platform and must be
-- nullable or defaulted: the provisioning sequence inserts only the core columns, then runs the
-- `after_tenant_row` hook for the rest.
--
-- tenant_provisioning_status changes only through provisioning and removal. Subscription states
-- (trial, active, expired, ...) live in the platform's subscription tables and never touch it.
CREATE TABLE IF NOT EXISTS tenants (
    uuid                        UUID PRIMARY KEY,
    name                        TEXT NOT NULL,
    slug                        TEXT,
    tenant_db_name              TEXT NOT NULL,
    tenant_provisioning_status  TEXT NOT NULL DEFAULT 'provisioning'
                                    CHECK (tenant_provisioning_status IN
                                        ('provisioning', 'provisioned', 'provisioning_failed', 'deprovisioning', 'deprovisioned')),
    created_by_identity_id      UUID,
    created_at                  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at                  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    provisioned_at              TIMESTAMPTZ,
    CONSTRAINT tenants_tenant_db_name_key UNIQUE (tenant_db_name)
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_tenants_slug ON tenants (slug) WHERE slug IS NOT NULL;

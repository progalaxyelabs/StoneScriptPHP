-- Platform identity (tenancy v2). Generated by `php stone generate tenancy`.
--
-- The slug is at most 19 characters so that {slug}_tenant_{uuid with underscores} fits a 63-byte database name.
-- Exactly ONE row (CHECK (singleton)). In external-auth mode platform_id comes from the auth service
-- (written by `php stone platform:register`) and is NULL until the platform is registered; in
-- standalone (builtin) mode it is generated locally.
CREATE TABLE IF NOT EXISTS platform (
    singleton       BOOLEAN PRIMARY KEY DEFAULT TRUE CHECK (singleton),
    platform_id     UUID,
    platform_name   TEXT NOT NULL,
    platform_slug   TEXT NOT NULL
                        CHECK (platform_slug ~ '^[a-z0-9]+(_[a-z0-9]+)*$' AND length(platform_slug) <= 19),
    auth_mode       TEXT NOT NULL DEFAULT 'external' CHECK (auth_mode IN ('external', 'builtin')),
    registered_at   TIMESTAMPTZ
);

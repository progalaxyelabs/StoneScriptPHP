-- Membership mirror drift (tenancy v2, external auth). Generated by `php stone generate tenancy`.
--
-- In external mode the auth service is the source of truth for membership status. A status change that auth
-- confirmed but that could not be mirrored into tenant_memberships is recorded here (ids and the status auth
-- confirmed, nothing else) and cleared by the next successful mirror write. `php stone tenancy:preflight` reports
-- every row left in this table.
CREATE TABLE IF NOT EXISTS tenancy_mirror_drift (
    membership_id   UUID PRIMARY KEY,
    auth_status     TEXT NOT NULL CHECK (auth_status IN ('active', 'suspended', 'removed')),
    recorded_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Tenant memberships. Generated by `php stone generate tenancy` ONLY when the project has
-- no tenant_memberships table yet.
--
-- NO role column: roles and privileges live in the tenant database (users, user_roles,
-- user_role_privileges). `id` is the authority's membership id (auth, or the builtin authority).
-- The tenant FK is ON DELETE NO ACTION: a tenant cannot be deleted while memberships exist; removal
-- moves children explicitly.
CREATE TABLE IF NOT EXISTS tenant_memberships (
    id                      UUID PRIMARY KEY,
    identity_id             UUID NOT NULL,
    tenant_id               UUID NOT NULL REFERENCES tenants (uuid) ON DELETE NO ACTION,
    is_tenant_owner         BOOLEAN NOT NULL DEFAULT FALSE,
    status                  TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'suspended', 'removed')),
    invited_by_identity_id  UUID,
    created_at              TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at              TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT tenant_memberships_identity_tenant_key UNIQUE (identity_id, tenant_id)
);

CREATE INDEX IF NOT EXISTS idx_tenant_memberships_tenant ON tenant_memberships (tenant_id);

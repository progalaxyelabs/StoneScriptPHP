-- Generated by `php stone generate tenancy`. Writes the singleton `platform` row.
--
-- `php stone platform:register` calls this with the platform_id the auth service issued; standalone
-- (builtin) platforms call it once with a locally generated uuid. Idempotent. A row that already holds a
-- DIFFERENT platform_id is never overwritten silently: that would re-point the platform at another identity.
CREATE OR REPLACE FUNCTION platform_upsert(
    p_platform_id UUID,
    p_platform_name TEXT,
    p_platform_slug TEXT,
    p_auth_mode TEXT
)
RETURNS TABLE (
    o_platform_id UUID,
    o_registered_at TIMESTAMPTZ
)
LANGUAGE plpgsql AS $$
DECLARE
    v_existing UUID;
BEGIN
    IF p_platform_slug IS NULL OR p_platform_slug !~ '^[a-z0-9]+(_[a-z0-9]+)*$' OR char_length(p_platform_slug) > 19 THEN
        RAISE EXCEPTION 'invalid_platform_slug: lower-case words joined by _, at most 19 characters';
    END IF;

    SELECT p.platform_id INTO v_existing FROM platform p;
    IF v_existing IS NOT NULL AND v_existing IS DISTINCT FROM p_platform_id THEN
        RAISE EXCEPTION 'platform_id_conflict: this database is already registered as a different platform';
    END IF;

    RETURN QUERY
    INSERT INTO platform (singleton, platform_id, platform_name, platform_slug, auth_mode, registered_at)
    VALUES (TRUE, p_platform_id, p_platform_name, p_platform_slug, p_auth_mode, NOW())
    ON CONFLICT (singleton) DO UPDATE SET
        platform_id   = EXCLUDED.platform_id,
        platform_name = EXCLUDED.platform_name,
        platform_slug = EXCLUDED.platform_slug,
        auth_mode     = EXCLUDED.auth_mode,
        registered_at = COALESCE(platform.registered_at, EXCLUDED.registered_at)
    RETURNING platform.platform_id, platform.registered_at;
END;
$$;

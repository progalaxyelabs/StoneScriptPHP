-- Generated by `php stone generate tenancy --builtin`. Standalone idempotency ledger: look up an
-- idempotency key (tenant reservation, or `member:<key>` for a staff invite).
CREATE OR REPLACE FUNCTION tenancy_find_request(
    p_idempotency_key TEXT
)
RETURNS TABLE (
    o_identity_id UUID,
    o_tenant_id UUID,
    o_membership_id UUID,
    o_tenant_db_name TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT r.identity_id, r.tenant_id, r.membership_id, r.tenant_db_name::TEXT
    FROM tenant_provision_requests r
    WHERE r.idempotency_key = p_idempotency_key;
END;
$$;

-- Generated by `php stone generate tenancy`. Mirror a membership status that the AUTH service already confirmed
-- into the platform's tenant_memberships row. Unlike tenancy_set_membership_status it applies NO last-owner rule:
-- in external mode auth is the source of truth and has already enforced it. Returns how many rows were updated
-- (0 = this platform has no such membership row, which the caller records as drift).
CREATE OR REPLACE FUNCTION tenancy_mirror_membership_status(
    p_membership_id UUID,
    p_status TEXT
)
RETURNS TABLE (
    o_updated INTEGER
)
LANGUAGE plpgsql AS $$
DECLARE
    v_rows INTEGER;
BEGIN
    IF p_status IS NULL OR p_status NOT IN ('active', 'suspended', 'removed') THEN
        RAISE EXCEPTION 'invalid_status';
    END IF;

    UPDATE tenant_memberships SET status = p_status, updated_at = NOW() WHERE id = p_membership_id;
    GET DIAGNOSTICS v_rows = ROW_COUNT;
    RETURN QUERY SELECT v_rows;
END;
$$;

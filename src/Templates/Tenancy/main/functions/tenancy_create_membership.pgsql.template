-- Generated by `php stone generate tenancy`. Step 5 of the provisioning sequence and the staff-invite write:
-- the main `tenant_memberships` row, with the id the authority generated.
--
-- Idempotent on (identity_id, tenant_id): a retry returns the EXISTING row's id (the caller compares it with
-- the authority's id and refuses a mismatch). There is no role column: roles live in the tenant database.
CREATE OR REPLACE FUNCTION tenancy_create_membership(
    p_id UUID,
    p_tenant_id UUID,
    p_identity_id UUID,
    p_is_tenant_owner BOOLEAN,
    p_invited_by_identity_id UUID DEFAULT NULL
)
RETURNS TABLE (
    o_id UUID
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    INSERT INTO tenant_memberships (id, identity_id, tenant_id, is_tenant_owner, status, invited_by_identity_id)
    VALUES (p_id, p_identity_id, p_tenant_id, p_is_tenant_owner, 'active', p_invited_by_identity_id)
    ON CONFLICT (identity_id, tenant_id) DO UPDATE SET updated_at = NOW()
    RETURNING tenant_memberships.id;
END;
$$;

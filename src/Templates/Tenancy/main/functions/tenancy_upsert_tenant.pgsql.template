-- Generated by `php stone generate tenancy`. Step 2 of the provisioning sequence: the main `tenants` row.
--
-- Idempotent on the tenant uuid (the authority's id). A new row starts as `provisioning`; a retry moves a
-- `provisioning_failed` row back to `provisioning` and leaves any other status alone (a `provisioned`
-- tenant stays provisioned). A different tenant_db_name for an existing tenant is refused: the name the
-- authority reserved is the only name this tenant may have.
CREATE OR REPLACE FUNCTION tenancy_upsert_tenant(
    p_uuid UUID,
    p_name TEXT,
    p_slug TEXT,
    p_tenant_db_name TEXT,
    p_created_by_identity_id UUID
)
RETURNS TABLE (
    o_status TEXT
)
LANGUAGE plpgsql AS $$
DECLARE
    v_db TEXT;
BEGIN
    SELECT t.tenant_db_name INTO v_db FROM tenants t WHERE t.uuid = p_uuid;
    IF v_db IS NOT NULL AND v_db <> p_tenant_db_name THEN
        RAISE EXCEPTION 'tenant_db_name_mismatch: tenant % already has a different tenant_db_name', p_uuid;
    END IF;

    RETURN QUERY
    INSERT INTO tenants (uuid, name, slug, tenant_db_name, tenant_provisioning_status, created_by_identity_id)
    VALUES (p_uuid, p_name, p_slug, p_tenant_db_name, 'provisioning', p_created_by_identity_id)
    ON CONFLICT (uuid) DO UPDATE SET
        tenant_db_name = COALESCE(tenants.tenant_db_name, EXCLUDED.tenant_db_name),
        tenant_provisioning_status = CASE
            WHEN tenants.tenant_provisioning_status = 'provisioning_failed' THEN 'provisioning'
            ELSE tenants.tenant_provisioning_status
        END,
        updated_at = NOW()
    RETURNING tenants.tenant_provisioning_status::TEXT;
END;
$$;

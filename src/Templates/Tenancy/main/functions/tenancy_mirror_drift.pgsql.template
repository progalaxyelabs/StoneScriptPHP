-- Generated by `php stone generate tenancy`. Record, clear and list membership mirror drift (see the
-- tenancy_mirror_drift table). One file, three small functions; ids and the status auth confirmed only.
CREATE OR REPLACE FUNCTION tenancy_record_mirror_drift(
    p_membership_id UUID,
    p_auth_status TEXT
)
RETURNS VOID
LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO tenancy_mirror_drift (membership_id, auth_status)
    VALUES (p_membership_id, p_auth_status)
    ON CONFLICT (membership_id) DO UPDATE SET auth_status = EXCLUDED.auth_status, recorded_at = NOW();
END;
$$;

CREATE OR REPLACE FUNCTION tenancy_clear_mirror_drift(
    p_membership_id UUID
)
RETURNS VOID
LANGUAGE plpgsql AS $$
BEGIN
    DELETE FROM tenancy_mirror_drift WHERE membership_id = p_membership_id;
END;
$$;

CREATE OR REPLACE FUNCTION tenancy_list_mirror_drift()
RETURNS TABLE (
    o_membership_id UUID,
    o_auth_status TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT d.membership_id, d.auth_status::TEXT FROM tenancy_mirror_drift d ORDER BY d.recorded_at, d.membership_id;
END;
$$;

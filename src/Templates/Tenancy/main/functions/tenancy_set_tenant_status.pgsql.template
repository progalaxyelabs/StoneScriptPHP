-- Generated by `php stone generate tenancy`. Moves tenants.tenant_provisioning_status.
--
-- The only legal values are provisioning, provisioned, provisioning_failed, deprovisioning, deprovisioned.
-- This column changes ONLY through provisioning and removal; subscription states never touch it.
-- Guards: a provisioned tenant is never marked provisioning_failed by a failed retry, and `provisioned`
-- is reachable only from provisioning/provisioned (or an unset legacy row).
CREATE OR REPLACE FUNCTION tenancy_set_tenant_status(
    p_tenant_id UUID,
    p_status TEXT
)
RETURNS VOID
LANGUAGE plpgsql AS $$
DECLARE
    v_current TEXT;
BEGIN
    IF p_status NOT IN ('provisioning', 'provisioned', 'provisioning_failed', 'deprovisioning', 'deprovisioned') THEN
        RAISE EXCEPTION 'invalid_tenant_provisioning_status: %', p_status;
    END IF;

    SELECT t.tenant_provisioning_status INTO v_current FROM tenants t WHERE t.uuid = p_tenant_id;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'tenant_not_found: %', p_tenant_id;
    END IF;

    IF p_status = 'provisioned' AND v_current IS NOT NULL AND v_current NOT IN ('provisioning', 'provisioned') THEN
        RAISE EXCEPTION 'illegal_status_transition: % -> provisioned', v_current;
    END IF;
    IF p_status = 'provisioning_failed' AND v_current = 'provisioned' THEN
        RAISE EXCEPTION 'illegal_status_transition: provisioned -> provisioning_failed';
    END IF;

    UPDATE tenants t
    SET tenant_provisioning_status = p_status,
        provisioned_at = CASE WHEN p_status = 'provisioned' THEN COALESCE(t.provisioned_at, NOW()) ELSE t.provisioned_at END,
        updated_at = NOW()
    WHERE t.uuid = p_tenant_id;
END;
$$;

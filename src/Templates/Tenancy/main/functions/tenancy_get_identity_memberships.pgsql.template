-- Generated by `php stone generate tenancy`. Login / tenant list / select-tenant source in standalone mode:
-- an identity's ACTIVE memberships on PROVISIONED tenants. Slug is optional and may be NULL.
CREATE OR REPLACE FUNCTION tenancy_get_identity_memberships(
    p_identity_id UUID
)
RETURNS TABLE (
    o_membership_id UUID,
    o_tenant_id UUID,
    o_tenant_name TEXT,
    o_tenant_slug TEXT,
    o_tenant_db_name TEXT,
    o_is_tenant_owner BOOLEAN
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT m.id, t.uuid, t.name::TEXT, t.slug::TEXT, t.tenant_db_name::TEXT, m.is_tenant_owner
    FROM tenant_memberships m
    JOIN tenants t ON t.uuid = m.tenant_id
    WHERE m.identity_id = p_identity_id
      AND m.status = 'active'
      AND t.tenant_provisioning_status = 'provisioned'
    ORDER BY t.created_at, t.uuid;
END;
$$;

-- Generated by `php stone generate tenancy`. An identity's membership of a tenant in ANY status (no row = none).
-- Used by the staff invite so a re-invite never silently reactivates a suspended or removed member.
CREATE OR REPLACE FUNCTION tenancy_find_membership(
    p_tenant_id UUID,
    p_identity_id UUID
)
RETURNS TABLE (
    o_id UUID,
    o_status TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT m.id, m.status::TEXT
    FROM tenant_memberships m
    WHERE m.tenant_id = p_tenant_id AND m.identity_id = p_identity_id;
END;
$$;

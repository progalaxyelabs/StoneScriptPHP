-- Generated by `php stone generate tenancy`. The tenants of this platform, optionally only those in one
-- tenant_provisioning_status. Used by `php stone tenancy:seed-privileges` and `php stone tenancy:preflight`,
-- which visit every provisioned tenant database.
CREATE OR REPLACE FUNCTION tenancy_list_tenants(
    p_status TEXT DEFAULT NULL
)
RETURNS TABLE (
    o_uuid UUID,
    o_name TEXT,
    o_tenant_db_name TEXT,
    o_status TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT t.uuid, t.name::TEXT, t.tenant_db_name::TEXT, t.tenant_provisioning_status::TEXT
    FROM tenants t
    WHERE p_status IS NULL OR t.tenant_provisioning_status = p_status
    ORDER BY t.created_at, t.uuid;
END;
$$;

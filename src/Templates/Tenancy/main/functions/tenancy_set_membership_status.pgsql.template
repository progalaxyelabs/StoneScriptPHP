-- Generated by `php stone generate tenancy`. Change a membership's status (active, suspended, removed).
-- A tenant never loses its last ACTIVE owner: suspending or removing it raises cannot_suspend_tenant_owner.
-- Who may call this is the platform's decision (its tenant-DB roles), checked before this runs.
CREATE OR REPLACE FUNCTION tenancy_set_membership_status(
    p_membership_id UUID,
    p_status TEXT
)
RETURNS VOID
LANGUAGE plpgsql AS $$
DECLARE
    v_member RECORD;
    v_other_active_owners INTEGER;
BEGIN
    IF p_status IS NULL OR p_status NOT IN ('active', 'suspended', 'removed') THEN
        RAISE EXCEPTION 'invalid_status';
    END IF;

    SELECT m.id, m.tenant_id, m.status, m.is_tenant_owner INTO v_member
    FROM tenant_memberships m WHERE m.id = p_membership_id FOR UPDATE;
    IF NOT FOUND THEN
        RAISE EXCEPTION 'membership_not_found';
    END IF;
    IF v_member.status = p_status THEN
        RETURN;
    END IF;

    IF p_status IN ('suspended', 'removed') AND v_member.is_tenant_owner AND v_member.status = 'active' THEN
        SELECT count(*) INTO v_other_active_owners
        FROM tenant_memberships m
        WHERE m.tenant_id = v_member.tenant_id AND m.is_tenant_owner AND m.status = 'active' AND m.id <> p_membership_id;
        IF v_other_active_owners = 0 THEN
            RAISE EXCEPTION 'cannot_suspend_tenant_owner';
        END IF;
    END IF;

    UPDATE tenant_memberships SET status = p_status, updated_at = NOW() WHERE id = p_membership_id;
END;
$$;

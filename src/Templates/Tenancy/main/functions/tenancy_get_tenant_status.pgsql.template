-- Generated by `php stone generate tenancy`. Current tenant_provisioning_status (no row = tenant unknown).
CREATE OR REPLACE FUNCTION tenancy_get_tenant_status(
    p_tenant_id UUID
)
RETURNS TABLE (
    o_status TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT t.tenant_provisioning_status::TEXT
    FROM tenants t
    WHERE t.uuid = p_tenant_id;
END;
$$;

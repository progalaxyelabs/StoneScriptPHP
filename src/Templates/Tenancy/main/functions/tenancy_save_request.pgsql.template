-- Generated by `php stone generate tenancy --builtin`. Record the ids an idempotency key reserved and return the
-- WINNING row. A key that already exists is left untouched (first writer wins), so two concurrent first calls
-- both end up with the same ids and a retry can never re-point the key.
CREATE OR REPLACE FUNCTION tenancy_save_request(
    p_idempotency_key TEXT,
    p_identity_id UUID,
    p_tenant_id UUID,
    p_membership_id UUID,
    p_tenant_db_name TEXT
)
RETURNS TABLE (
    o_identity_id UUID,
    o_tenant_id UUID,
    o_membership_id UUID,
    o_tenant_db_name TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    INSERT INTO tenant_provision_requests (idempotency_key, identity_id, tenant_id, membership_id, tenant_db_name)
    VALUES (p_idempotency_key, p_identity_id, p_tenant_id, p_membership_id, p_tenant_db_name)
    ON CONFLICT (idempotency_key) DO NOTHING;

    RETURN QUERY
    SELECT r.identity_id, r.tenant_id, r.membership_id, r.tenant_db_name::TEXT
    FROM tenant_provision_requests r
    WHERE r.idempotency_key = p_idempotency_key;
END;
$$;

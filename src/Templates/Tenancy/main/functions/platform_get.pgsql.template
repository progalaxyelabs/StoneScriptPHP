-- Generated by `php stone generate tenancy`. The platform's own identity row (zero or one row).
-- plpgsql on purpose: functions deploy before migrations/table sync, so a body that names a table or
-- column must not be validated at CREATE time.
CREATE OR REPLACE FUNCTION platform_get()
RETURNS TABLE (
    o_platform_id UUID,
    o_platform_name TEXT,
    o_platform_slug TEXT,
    o_auth_mode TEXT,
    o_registered_at TIMESTAMPTZ
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT p.platform_id, p.platform_name, p.platform_slug, p.auth_mode, p.registered_at
    FROM platform p;
END;
$$;

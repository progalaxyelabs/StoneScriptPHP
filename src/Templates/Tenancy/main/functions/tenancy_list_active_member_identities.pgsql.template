-- Generated by `php stone generate tenancy`. The identities with an ACTIVE membership of a tenant (main database).
-- Used by `php stone tenancy:preflight` to check each of them against the tenant database.
CREATE OR REPLACE FUNCTION tenancy_list_active_member_identities(
    p_tenant_id UUID
)
RETURNS TABLE (
    o_identity_id UUID
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
    SELECT m.identity_id FROM tenant_memberships m
    WHERE m.tenant_id = p_tenant_id AND m.status = 'active'
    ORDER BY m.identity_id;
END;
$$;

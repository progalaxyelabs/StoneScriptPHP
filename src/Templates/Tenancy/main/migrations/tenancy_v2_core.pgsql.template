-- Tenancy v2 main-database migration. Generated by `php stone generate tenancy`.
--
-- FORWARD-ONLY and IDEMPOTENT: additive DDL with IF NOT EXISTS guards; nothing here drops, truncates or
-- retypes anything, and re-running it on any database at any state is a no-op. Gateway order: functions are
-- deployed first, this migration second, declarative table sync last. On a brand-new database the tables do
-- not exist yet at this point (sync creates them in the right shape), so every block is guarded with
-- to_regclass() and does nothing.
--
-- On a database that already has `tenants` / `tenant_memberships` it EXPANDS them to the v2 core columns.
-- Before it tightens anything (a unique index, a CHECK) it checks the existing data and raises a clear
-- exception naming what is wrong; fix the data and re-run. It never guesses: rows whose provisioning state
-- cannot be derived keep a NULL status (never offered at login, reported in a NOTICE), never `provisioned`.
-- Old columns (for example memberships.role, tenants.db_status) are left in place; retire them in a later
-- release through the gateway's drop-column wrapper once nothing reads them.

-- ---------------------------------------------------------------------------------------------------------
-- tenants: core columns
-- ---------------------------------------------------------------------------------------------------------
DO $$
DECLARE
    v_dups TEXT;
    v_has_db_status BOOLEAN;
    v_unmapped BIGINT;
BEGIN
    IF to_regclass('tenants') IS NULL THEN
        RETURN;
    END IF;

    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS name TEXT;
    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS slug TEXT;
    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS tenant_db_name TEXT;
    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS created_by_identity_id UUID;
    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS created_at TIMESTAMPTZ NOT NULL DEFAULT NOW();
    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW();
    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS provisioned_at TIMESTAMPTZ;

    ALTER TABLE tenants ADD COLUMN IF NOT EXISTS tenant_provisioning_status TEXT;

    -- Derive the state of every tenant that has none yet, on EVERY run (a row the old flow wrote since the last run
    -- is picked up too). Mapping of the old db_status: creating -> provisioning, active -> provisioned, error ->
    -- provisioning_failed, suspended -> provisioned (a suspension is not a provisioning state: the database exists),
    -- deleted -> deprovisioned. Any other value is NOT guessed: the row keeps a NULL status (never offered at login)
    -- and is counted in a NOTICE for review. Without a db_status column the existing rows are the live tenants.
    SELECT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = 'tenants' AND column_name = 'db_status'
    ) INTO v_has_db_status;

    IF v_has_db_status THEN
        EXECUTE $q$
            UPDATE tenants SET
                tenant_provisioning_status = CASE db_status
                    WHEN 'creating'  THEN 'provisioning'
                    WHEN 'active'    THEN 'provisioned'
                    WHEN 'error'     THEN 'provisioning_failed'
                    WHEN 'suspended' THEN 'provisioned'
                    WHEN 'deleted'   THEN 'deprovisioned'
                END,
                provisioned_at = CASE WHEN db_status IN ('active', 'suspended') THEN COALESCE(provisioned_at, created_at) ELSE provisioned_at END
            WHERE tenant_provisioning_status IS NULL AND db_status IN ('creating', 'active', 'error', 'suspended', 'deleted')
        $q$;
        EXECUTE 'SELECT count(*) FROM tenants WHERE tenant_provisioning_status IS NULL' INTO v_unmapped;
        IF v_unmapped > 0 THEN
            RAISE NOTICE 'tenancy_v2: % tenant(s) have a db_status that is not mapped; their tenant_provisioning_status stays NULL (not offered at login) until you set it', v_unmapped;
        END IF;
    ELSE
        UPDATE tenants
        SET tenant_provisioning_status = 'provisioned',
            provisioned_at = COALESCE(provisioned_at, created_at)
        WHERE tenant_provisioning_status IS NULL;
    END IF;

    -- Vocabulary guard (nullable during the expand phase; tighten to NOT NULL in a later release).
    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'tenants_provisioning_status_check' AND conrelid = 'tenants'::regclass) THEN
        ALTER TABLE tenants ADD CONSTRAINT tenants_provisioning_status_check CHECK (
            tenant_provisioning_status IS NULL OR tenant_provisioning_status IN
                ('provisioning', 'provisioned', 'provisioning_failed', 'deprovisioning', 'deprovisioned')
        );
    END IF;

    -- tenant_db_name must be unique: refuse loudly when two tenants already share a name.
    SELECT string_agg(d.tenant_db_name || ' x' || d.n, ', ') INTO v_dups
    FROM (SELECT tenant_db_name, count(*) AS n FROM tenants WHERE tenant_db_name IS NOT NULL GROUP BY tenant_db_name HAVING count(*) > 1) d;
    IF v_dups IS NOT NULL THEN
        RAISE EXCEPTION 'tenancy_v2: duplicate tenants.tenant_db_name values, resolve before migrating: %', v_dups;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'tenants_tenant_db_name_key' AND conrelid = 'tenants'::regclass) THEN
        ALTER TABLE tenants ADD CONSTRAINT tenants_tenant_db_name_key UNIQUE (tenant_db_name);
    END IF;

    -- slug is optional; unique only when set.
    SELECT string_agg(d.slug || ' x' || d.n, ', ') INTO v_dups
    FROM (SELECT slug, count(*) AS n FROM tenants WHERE slug IS NOT NULL GROUP BY slug HAVING count(*) > 1) d;
    IF v_dups IS NOT NULL THEN
        RAISE EXCEPTION 'tenancy_v2: duplicate tenants.slug values, resolve before migrating: %', v_dups;
    END IF;
    CREATE UNIQUE INDEX IF NOT EXISTS idx_tenants_slug ON tenants (slug) WHERE slug IS NOT NULL;
END;
$$;

-- ---------------------------------------------------------------------------------------------------------
-- tenant_memberships: v2 shape (no role column)
-- ---------------------------------------------------------------------------------------------------------
DO $$
DECLARE
    v_dups TEXT;
    v_owner_col_existed BOOLEAN;
    v_tenant_id_type TEXT;
    v_has_role BOOLEAN;
BEGIN
    IF to_regclass('tenant_memberships') IS NULL THEN
        RETURN;
    END IF;

    SELECT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = 'tenant_memberships' AND column_name = 'is_tenant_owner'
    ) INTO v_owner_col_existed;
    SELECT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = 'tenant_memberships' AND column_name = 'role'
    ) INTO v_has_role;

    ALTER TABLE tenant_memberships ADD COLUMN IF NOT EXISTS is_tenant_owner BOOLEAN NOT NULL DEFAULT FALSE;
    ALTER TABLE tenant_memberships ADD COLUMN IF NOT EXISTS invited_by_identity_id UUID;
    ALTER TABLE tenant_memberships ADD COLUMN IF NOT EXISTS created_at TIMESTAMPTZ NOT NULL DEFAULT NOW();
    ALTER TABLE tenant_memberships ADD COLUMN IF NOT EXISTS updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW();

    -- A table that had a role column but no owner flag: carry "owner" over once, when the flag is created.
    IF NOT v_owner_col_existed AND v_has_role THEN
        EXECUTE $q$UPDATE tenant_memberships SET is_tenant_owner = TRUE WHERE role = 'owner'$q$;
    END IF;

    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = 'tenant_memberships' AND column_name = 'status'
    ) THEN
        ALTER TABLE tenant_memberships ADD COLUMN status TEXT NOT NULL DEFAULT 'active';
        ALTER TABLE tenant_memberships ADD CONSTRAINT tenant_memberships_status_check CHECK (status IN ('active', 'suspended', 'removed'));
    END IF;

    -- One membership per (identity, tenant): refuse loudly on existing duplicates.
    SELECT string_agg(d.identity_id::TEXT || '/' || d.tenant_id::TEXT || ' x' || d.n, ', ') INTO v_dups
    FROM (SELECT identity_id, tenant_id, count(*) AS n FROM tenant_memberships GROUP BY identity_id, tenant_id HAVING count(*) > 1) d;
    IF v_dups IS NOT NULL THEN
        RAISE EXCEPTION 'tenancy_v2: duplicate tenant_memberships (identity/tenant) rows, resolve before migrating: %', v_dups;
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'tenant_memberships_identity_tenant_key' AND conrelid = 'tenant_memberships'::regclass) THEN
        ALTER TABLE tenant_memberships ADD CONSTRAINT tenant_memberships_identity_tenant_key UNIQUE (identity_id, tenant_id);
    END IF;

    -- Real FK to tenants(uuid), NOT VALID so existing orphans do not block the migration (validate later).
    IF to_regclass('tenants') IS NOT NULL
       AND NOT EXISTS (
            SELECT 1 FROM pg_constraint
            WHERE conrelid = 'tenant_memberships'::regclass AND contype = 'f' AND confrelid = 'tenants'::regclass
       ) THEN
        SELECT data_type INTO v_tenant_id_type FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = 'tenant_memberships' AND column_name = 'tenant_id';
        IF v_tenant_id_type IS DISTINCT FROM 'uuid' THEN
            RAISE EXCEPTION 'tenancy_v2: tenant_memberships.tenant_id is % (uuid required). Convert it with the gateway change-column helper first, then re-run.', v_tenant_id_type;
        END IF;
        ALTER TABLE tenant_memberships
            ADD CONSTRAINT tenant_memberships_tenant_fk FOREIGN KEY (tenant_id) REFERENCES tenants (uuid) ON DELETE NO ACTION NOT VALID;
    END IF;
END;
$$;

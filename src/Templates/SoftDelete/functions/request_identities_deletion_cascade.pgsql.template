-- Generated by `php stone generate soft-delete` (cascade variant — used
-- automatically for the identities table when 'tenants' is also in
-- --tables, which is the default).
--
-- Same contract as request_<table>_deletion_with_email (soft-delete +
-- archive + email capture for is_email_blocked()), PLUS: walks every tenant
-- this identity CREATED (tenant_memberships.is_tenant_creator, from
-- `php stone generate tenant-governance`) and soft-deletes those tenants
-- too, in the SAME transaction — an identity's owned tenants must not
-- outlive the identity as orphaned, ownerless data (design doc §2,
-- "Cascade care").
--
-- Best-effort: if tenant_memberships/tenants don't exist on THIS database
-- (tenant-governance not installed here, or tenants live elsewhere), the
-- cascade block is skipped via to_regclass() guards — the identity is still
-- soft-deleted correctly, just with no cascade.
--
-- Does NOT touch tenant_memberships.is_tenant_creator (that column is
-- immutable — enforced by trg_protect_tenant_creator from the
-- tenant-governance generator). It only sets status='removed' on every
-- membership of the cascaded tenant, which that trigger does not restrict
-- (it only guards is_tenant_creator changes and hard DELETEs) — verified
-- compatible, no changes needed to that trigger.
CREATE OR REPLACE FUNCTION request_identities_deletion(
    p_id UUID,
    p_requested_by TEXT DEFAULT NULL
)
RETURNS TABLE (o_error TEXT, o_deleted_at TIMESTAMPTZ, o_purge_after TIMESTAMPTZ)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
    v_now TIMESTAMPTZ := NOW();
    v_purge_after TIMESTAMPTZ := v_now + INTERVAL '7 days';
    v_email TEXT;
    v_tenant_id UUID;
BEGIN
    UPDATE identities
       SET deleted_at = v_now, purge_after = v_purge_after, delete_requested_by = p_requested_by
     WHERE id = p_id AND deleted_at IS NULL
    RETURNING email INTO v_email;

    IF NOT FOUND THEN
        RETURN QUERY SELECT 'not_found_or_already_deleted'::TEXT, NULL::TIMESTAMPTZ, NULL::TIMESTAMPTZ;
        RETURN;
    END IF;

    INSERT INTO _deletion_archive (source_table, subject_id, email, requested_by, deleted_at, purge_after)
    VALUES ('identities', p_id::text, v_email, p_requested_by, v_now, v_purge_after);

    IF to_regclass('tenant_memberships') IS NOT NULL AND to_regclass('tenants') IS NOT NULL THEN
        FOR v_tenant_id IN
            SELECT tenant_id FROM tenant_memberships
             WHERE identity_id = p_id AND is_tenant_creator = true
        LOOP
            UPDATE tenants
               SET deleted_at = v_now, purge_after = v_purge_after, delete_requested_by = p_requested_by
             WHERE uuid = v_tenant_id AND deleted_at IS NULL;

            IF FOUND THEN
                INSERT INTO _deletion_archive (source_table, subject_id, requested_by, deleted_at, purge_after)
                VALUES ('tenants', v_tenant_id::text, p_requested_by, v_now, v_purge_after);
            END IF;

            UPDATE tenant_memberships
               SET status = 'removed', updated_at = v_now
             WHERE tenant_id = v_tenant_id AND status <> 'removed';
        END LOOP;
    END IF;

    RETURN QUERY SELECT NULL::TEXT, v_now, v_purge_after;
END;
$$;

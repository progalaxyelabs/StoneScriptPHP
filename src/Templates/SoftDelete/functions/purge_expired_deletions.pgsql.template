-- Generated by `php stone generate soft-delete`.
--
-- Run daily (wire into this platform's own cron/scheduler — the framework
-- does not ship a scheduler; see the generator's --help output). For every
-- configured table, physically DELETEs rows past their 7-day purge_after,
-- then marks the corresponding _deletion_archive rows purged=true (the
-- archive row itself is NEVER deleted — see that table's comment).
--
-- The DELETE is what makes this real: if `php stone generate audit` is
-- installed on a given table, that DELETE fires the AFTER-row trigger and
-- writes the immutable _audit_log proof of erasure in the SAME transaction
-- as the physical delete — the two can never drift apart. If audit is NOT
-- installed on a table, the delete still happens safely, it just leaves no
-- immutable trail — install `php stone generate audit` first if that
-- matters for a given table (it does, for identities/tenants).
CREATE OR REPLACE FUNCTION purge_expired_deletions()
RETURNS TABLE (o_table_name TEXT, o_purged_count INTEGER)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
    v_count INTEGER;
BEGIN
__PURGE_TABLE_BLOCKS__
    RETURN;
END;
$$;

-- Generated by `php stone generate soft-delete`.
--
-- Restore is SUPPORT-ONLY, by design — there is deliberately no
-- self-service "cancel my deletion" route generated anywhere in this
-- framework. This function exists so a support operator restoring a row
-- goes through an auditable code path (captured by the AFTER-row audit
-- trigger as an UPDATE, if `php stone generate audit` is installed on this
-- table) instead of an untracked raw UPDATE via psql.
--
-- Naturally a no-op (not_found_or_not_deleted) once the row has actually
-- been purged — there is nothing left to restore; that is the entire point
-- of the 7-day window being real. The _deletion_archive row for this
-- deletion is left untouched (archive rows are never deleted/modified) —
-- the restore itself is what the audit log's UPDATE row proves happened.
CREATE OR REPLACE FUNCTION support_restore___TABLE___deletion(
    p___PK_COLUMN__ __PK_TYPE__,
    p_actor_id TEXT DEFAULT NULL
)
RETURNS TABLE (o_error TEXT)
LANGUAGE plpgsql AS $$
BEGIN
    PERFORM set_config('app.actor_id', COALESCE(p_actor_id, ''), true);

    UPDATE __TABLE__
       SET deleted_at = NULL, purge_after = NULL, delete_requested_by = NULL
     WHERE __PK_COLUMN__ = p___PK_COLUMN__ AND deleted_at IS NOT NULL;

    IF NOT FOUND THEN
        RETURN QUERY SELECT 'not_found_or_not_deleted'::TEXT;
        RETURN;
    END IF;

    RETURN QUERY SELECT NULL::TEXT;
END;
$$;

    BEGIN
        IF to_regclass('tenants') IS NOT NULL THEN
            -- Sanctioned bypass for tenant-governance's
            -- trg_protect_tenant_creator (see that trigger's own header
            -- comment for the full mechanism + its documented limitation).
            -- is_local=true: self-reverts at end of transaction OR if this
            -- BEGIN/EXCEPTION sub-block rolls back — never leaks past this
            -- purge call, never touches another session's GUCs.
            PERFORM set_config('stonescriptphp.tenant_purge_in_progress', 'on', true);

            WITH deleted_rows AS (
                DELETE FROM tenants
                 WHERE deleted_at IS NOT NULL AND purge_after < NOW()
                RETURNING uuid::text AS subject_id, deleted_at
            )
            SELECT
                COALESCE(array_agg(subject_id), ARRAY[]::text[]),
                COALESCE(array_agg(deleted_at), ARRAY[]::timestamptz[])
              INTO v_deleted_ids, v_deleted_ats
              FROM deleted_rows;

            -- Clear it immediately — minimizes the window this GUC is 'on'
            -- for the rest of the (possibly longer-lived) outer transaction.
            PERFORM set_config('stonescriptphp.tenant_purge_in_progress', 'off', true);

            v_count := COALESCE(array_length(v_deleted_ids, 1), 0);

            -- Paired on (subject_id, deleted_at) — see
            -- _purge_table_block.pgsql.template's comment for why subject_id
            -- alone is not precise enough (restore-then-redelete cycles).
            IF v_count > 0 THEN
                UPDATE _deletion_archive a
                   SET purged = true, purged_at = NOW()
                  FROM unnest(v_deleted_ids, v_deleted_ats) AS d(subject_id, deleted_at)
                 WHERE a.source_table = 'tenants'
                   AND a.subject_id = d.subject_id
                   AND a.deleted_at = d.deleted_at
                   AND a.purged = false;
            END IF;

            RETURN QUERY SELECT 'tenants'::TEXT, v_count, NULL::TEXT;
        END IF;
    EXCEPTION WHEN OTHERS THEN
        -- The DELETE above relies on tenant_memberships.tenant_id
        -- REFERENCES tenants(uuid) ON DELETE CASCADE (from `php stone
        -- generate tenant-governance`) to clean up memberships
        -- automatically. That CASCADE performs a real per-row DELETE on
        -- tenant_memberships, which fires THAT table's own
        -- trg_protect_tenant_creator trigger — normally a hard backstop
        -- against deleting an is_tenant_creator row, but that trigger now
        -- recognizes THIS purge path (via the
        -- stonescriptphp.tenant_purge_in_progress GUC set just above — see
        -- its own header comment for the full mechanism and its honestly-
        -- documented spoofing caveat) and lets it through. This EXCEPTION
        -- block therefore now only catches a genuinely UNEXPECTED blocker —
        -- a platform-added FK/trigger with its own RESTRICT/custom
        -- exception on tenants or tenant_memberships, not this trigger.
        --
        -- Because a plpgsql exception rolls back this BEGIN block's own
        -- subtransaction, the set_config('...', 'on', true) above is
        -- already undone by the time we get here — this explicit 'off' is
        -- redundant-but-cheap belt-and-suspenders, not load-bearing.
        PERFORM set_config('stonescriptphp.tenant_purge_in_progress', 'off', true);
        --
        -- WHEN OTHERS (not just foreign_key_violation) is deliberate: any
        -- OTHER platform-added trigger/constraint that blocks this table's
        -- purge raises its own SQLSTATE — reporting it via o_error for
        -- 'tenants' ONLY, without wedging or rolling back any other table's
        -- already-completed purge in the same run (this BEGIN/EXCEPTION is
        -- its own sub-transaction/savepoint). Retried automatically on the
        -- next scheduled run.
        RETURN QUERY SELECT 'tenants'::TEXT, 0, SQLERRM;
    END;

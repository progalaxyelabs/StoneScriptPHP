-- Generated by `php stone generate soft-delete`.
--
-- Marks the row soft-deleted (deleted_at/purge_after/delete_requested_by)
-- and writes the columnar half of the two-tier deletion record
-- (_deletion_archive) in the SAME transaction, so the archive row can never
-- exist without a corresponding soft-delete having actually happened.
-- Idempotent: refuses (already_deleted) if the row is already soft-deleted
-- rather than resetting the 7-day clock.
--
-- Purge (7 days later, purge_expired_deletions()) does the actual DELETE —
-- that DELETE, not this function, is what the AFTER-row audit trigger (if
-- `php stone generate audit` is installed on this table) captures as the
-- immutable proof of erasure; this function's own UPDATE is captured too,
-- as the immutable proof of the REQUEST.
CREATE OR REPLACE FUNCTION request___TABLE___deletion(
    p___PK_COLUMN__ __PK_TYPE__,
    p_requested_by TEXT DEFAULT NULL
)
RETURNS TABLE (o_error TEXT, o_deleted_at TIMESTAMPTZ, o_purge_after TIMESTAMPTZ)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
    v_now TIMESTAMPTZ := NOW();
    v_purge_after TIMESTAMPTZ := v_now + INTERVAL '7 days';
BEGIN
    UPDATE __TABLE__
       SET deleted_at = v_now, purge_after = v_purge_after, delete_requested_by = p_requested_by
     WHERE __PK_COLUMN__ = p___PK_COLUMN__ AND deleted_at IS NULL;

    IF NOT FOUND THEN
        RETURN QUERY SELECT 'not_found_or_already_deleted'::TEXT, NULL::TIMESTAMPTZ, NULL::TIMESTAMPTZ;
        RETURN;
    END IF;

    INSERT INTO _deletion_archive (source_table, subject_id, requested_by, deleted_at, purge_after)
    VALUES ('__TABLE__', p___PK_COLUMN__::text, p_requested_by, v_now, v_purge_after);

    RETURN QUERY SELECT NULL::TEXT, v_now, v_purge_after;
END;
$$;

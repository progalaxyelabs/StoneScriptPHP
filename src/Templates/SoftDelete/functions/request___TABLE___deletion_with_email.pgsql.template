-- Generated by `php stone generate soft-delete`.
--
-- Same contract as the plain request_<table>_deletion() (see that
-- template's comment) plus: captures __EMAIL_COLUMN__ into
-- _deletion_archive.email so signin/signup can still block re-registration
-- of a purged email after the live row is gone (is_email_blocked() consults
-- this archive precisely because, post-purge, there is no live row left to
-- check).
CREATE OR REPLACE FUNCTION request___TABLE___deletion(
    p___PK_COLUMN__ __PK_TYPE__,
    p_requested_by TEXT DEFAULT NULL
)
RETURNS TABLE (o_error TEXT, o_deleted_at TIMESTAMPTZ, o_purge_after TIMESTAMPTZ)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
DECLARE
    v_now TIMESTAMPTZ := NOW();
    v_purge_after TIMESTAMPTZ := v_now + INTERVAL '7 days';
    v_email TEXT;
BEGIN
    -- "Who" — see request_<table>_deletion.pgsql.template's comment on why
    -- this must be set explicitly, not left to the caller's own context.
    PERFORM set_config('app.actor_id', COALESCE(p_requested_by, ''), true);

    UPDATE __TABLE__
       SET deleted_at = v_now, purge_after = v_purge_after, delete_requested_by = p_requested_by
     WHERE __PK_COLUMN__ = p___PK_COLUMN__ AND deleted_at IS NULL
    RETURNING __EMAIL_COLUMN__ INTO v_email;

    IF NOT FOUND THEN
        RETURN QUERY SELECT 'not_found_or_already_deleted'::TEXT, NULL::TIMESTAMPTZ, NULL::TIMESTAMPTZ;
        RETURN;
    END IF;

    INSERT INTO _deletion_archive (source_table, subject_id, email, requested_by, deleted_at, purge_after)
    VALUES ('__TABLE__', p___PK_COLUMN__::text, v_email, p_requested_by, v_now, v_purge_after);

    RETURN QUERY SELECT NULL::TEXT, v_now, v_purge_after;
END;
$$;

-- Generated by `php stone generate soft-delete` (only when the identities
-- table — or whichever table is configured with an email column — is in
-- --tables).
--
-- Call from the signin AND signup routes: a soft-deleted or purged email
-- must show "invalid email, contact support", not the generic
-- "wrong password" / "email already registered" messaging (design doc §2).
-- Covers both cases:
--   - soft-deleted, not yet purged: live row still exists, deleted_at IS
--     NOT NULL.
--   - purged: no live row left at all — only _deletion_archive.email (from
--     request___EMAIL_TABLE___deletion) proves it ever existed.
CREATE OR REPLACE FUNCTION is_email_blocked(p_email TEXT)
RETURNS BOOLEAN
LANGUAGE plpgsql AS $$
BEGIN
    IF to_regclass('__EMAIL_TABLE__') IS NOT NULL THEN
        PERFORM 1 FROM __EMAIL_TABLE__ WHERE __EMAIL_COLUMN__ = p_email AND deleted_at IS NOT NULL;
        IF FOUND THEN
            RETURN true;
        END IF;
    END IF;

    PERFORM 1 FROM _deletion_archive WHERE email = p_email;
    IF FOUND THEN
        RETURN true;
    END IF;

    RETURN false;
END;
$$;

-- 7-day soft-delete + purge scaffolding.
--
-- Generated by `php stone generate soft-delete`. Non-destructive, idempotent
-- DDL only — safe to re-run on any database at any state (this framework's
-- migration-safety rule: additive schema changes only, IF NOT EXISTS/IF
-- EXISTS guards throughout, nothing that removes data). Adding
-- deleted_at/purge_after/delete_requested_by columns is purely additive; the
-- destructive half (the actual DELETE) lives in purge_expired_deletions()
-- and only fires per-row, 7 days after an explicit request_*_deletion()
-- call — never from this migration.
CREATE TABLE IF NOT EXISTS _deletion_archive (
    archive_id      BIGSERIAL PRIMARY KEY,
    source_table    TEXT NOT NULL,
    subject_id      TEXT NOT NULL,
    email           TEXT,
    requested_by    TEXT,
    deleted_at      TIMESTAMPTZ NOT NULL,
    purge_after     TIMESTAMPTZ NOT NULL,
    purged          BOOLEAN NOT NULL DEFAULT false,
    purged_at       TIMESTAMPTZ,
    archived_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_deletion_archive_email ON _deletion_archive(email) WHERE email IS NOT NULL;
CREATE INDEX IF NOT EXISTS idx_deletion_archive_source_subject ON _deletion_archive(source_table, subject_id);

-- Append-only enforcement, with one deliberate carve-out. Targets
-- current_user (the role actually running this migration, which in this
-- framework's gateway-only architecture is the same role the app uses at
-- runtime — there is normally no separate, more-privileged "owner" role to
-- fall back on, which is WHY this is a column-level grant rather than a
-- SECURITY DEFINER trick: SECURITY DEFINER only changes anything when the
-- function's owner is a DIFFERENT, less-restricted role than the caller —
-- in the common single-role deployment this framework assumes, owner ==
-- app role == the exact role being revoked from, so marking a function
-- SECURITY DEFINER here buys nothing on its own; the request_*_deletion()
-- and purge_expired_deletions() functions are still marked SECURITY
-- DEFINER as harmless defense-in-depth for any deployment that DOES
-- provision a separate, more-privileged owner role, but do not rely on it).
--
-- The substantive, historical fields (source_table, subject_id, email,
-- requested_by, deleted_at, purge_after, archived_at) are fully immutable
-- to the app role — no UPDATE, DELETE, or TRUNCATE, ever, ordinary INSERT
-- only (defense in depth, mirrors _audit_log). purge_expired_deletions()
-- legitimately needs to flip exactly two OPERATIONAL bookkeeping columns
-- (purged, purged_at) when a row's purge actually runs — so those two, and
-- only those two, get a narrow column-level UPDATE grant back. This is the
-- real mechanism that makes "archive rows never deleted" (design doc §2)
-- true in the deployment this framework actually has, not an illusion of
-- one that assumes role separation it doesn't provide.
DO $$
DECLARE
    v_role TEXT := current_user;
BEGIN
    EXECUTE format('REVOKE UPDATE, DELETE, TRUNCATE ON _deletion_archive FROM %I', v_role);
    EXECUTE format('GRANT UPDATE (purged, purged_at) ON _deletion_archive TO %I', v_role);
END $$;

-- Add the three soft-delete columns to each configured table. Per the
-- gateway's real deploy order (extensions -> types -> TABLES -> FUNCTIONS
-- -> MIGRATIONS -> verify_schema, every /v2/migrate run), this table
-- normally already exists here if declared declaratively. Each block is
-- still guarded with to_regclass() — but NON-silently: a missing table
-- RAISEs a WARNING rather than a quiet skip (see that block's own comment),
-- so a genuinely missing table surfaces in the migration log instead of
-- request_*_deletion() 500ing at runtime with no explanation.
--
-- The generator ALSO patches each configured table's OWN declarative file
-- (src/postgresql/.../tables/<table>.pgsql) with these same three columns,
-- when it can find one — the gateway's table-deploy step is declarative and
-- NEVER alters an existing table on its own (only migrations do), and its
-- read-only verify_schema step (which runs LAST, after migrations) compares
-- live columns against that declarative file; leaving it un-patched would
-- make every future deploy flag a spurious, permanent drift warning between
-- "what verify_schema expects" and "what this migration actually added".

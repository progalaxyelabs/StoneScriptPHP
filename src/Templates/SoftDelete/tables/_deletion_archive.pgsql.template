-- Two-tier deletion record — the columnar, queryable half.
--
-- Generated by `php stone generate soft-delete`. Written by every
-- request_<table>_deletion() function AT SOFT-DELETE TIME (not at purge
-- time), so it survives independently of the live row it describes —
-- rows here are NEVER deleted, not even by purge_expired_deletions()
-- (that function only flips purged=true). This is what lets signin/signup
-- say "invalid email, contact support" for an email whose live identities
-- row has already been physically purged (see is_email_blocked()).
--
-- The OTHER half of the two-tier design is `_audit_log` (from
-- `php stone generate audit`, if installed) — its DELETE row is the
-- immutable, trigger-guaranteed proof that the purge happened; this table
-- is the queryable, GDPR-style snapshot of what was requested and when.
-- Neither replaces the other.
CREATE TABLE IF NOT EXISTS _deletion_archive (
    archive_id      BIGSERIAL PRIMARY KEY,
    source_table    TEXT NOT NULL,
    subject_id      TEXT NOT NULL,

    -- Only populated for tables with an email column (identities-like
    -- tables) — the sole reason this column exists is so signin/signup can
    -- block a purged email with no live row left to check. NULL for
    -- tables with no email concept (e.g. tenants).
    email           TEXT,

    requested_by    TEXT,
    deleted_at      TIMESTAMPTZ NOT NULL,
    purge_after     TIMESTAMPTZ NOT NULL,
    purged          BOOLEAN NOT NULL DEFAULT false,
    purged_at       TIMESTAMPTZ,
    archived_at     TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_deletion_archive_email ON _deletion_archive(email) WHERE email IS NOT NULL;
CREATE INDEX IF NOT EXISTS idx_deletion_archive_source_subject ON _deletion_archive(source_table, subject_id);

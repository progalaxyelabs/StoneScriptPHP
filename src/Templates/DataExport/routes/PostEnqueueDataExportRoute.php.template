<?php

declare(strict_types=1);

namespace App\Routes\DataExport;

use App\Database\Functions\EnqueueDataExportJobParams;
use App\Database\Functions\FnEnqueueDataExportJob;
use StoneScriptPHP\ApiResponse;
use StoneScriptPHP\IRouteHandler;

/**
 * POST {prefix}/data-export/enqueue
 *
 * Generated by `php stone generate data-export`. The checkbox-driven
 * enqueue endpoint for the close-account / delete-tenant flow — this is
 * the ONLY thing the request path does (a fast INSERT via
 * enqueue_data_export_job(); see that function's own header comment). It
 * returns immediately with a job_uuid the caller can poll; NO export work
 * happens here.
 *
 * ⚠️  AUTHORIZATION — this route trusts `auth()`'s identity for
 * requested_by (never the request body), but for export_scope='tenant' it
 * is THIS PLATFORM'S job to verify the caller is an owner/admin of
 * tenant_id before calling enqueue — the TODO below is not optional, it is
 * the only thing standing between any authenticated user and exporting any
 * other tenant's data. Wire it to whatever this platform's own
 * tenant-membership/role check already is (e.g.
 * StoneScriptPHP\Auth\TenantGovernance\TenantGovernanceResolver if `php
 * stone generate tenant-governance` is installed).
 *
 * You own this file — edit freely, e.g. to wire it into a close-account
 * route's own checkbox handling directly instead of a standalone endpoint.
 */
class PostEnqueueDataExportRoute implements IRouteHandler
{
    public string $export_scope = '';
    public ?string $tenant_id = null;
    public string $format = 'csv';

    public function validation_rules(): array
    {
        return [
            'export_scope' => 'required|string|in:account,tenant',
            'tenant_id'    => 'nullable|string|max:255',
            'format'       => 'required|string|in:csv,xlsx',
        ];
    }

    public function process(): ApiResponse
    {
        $user = auth();
        if (!$user || !isset($user->user_id)) {
            return res_error('Authorization required', 401);
        }

        if ($this->export_scope === 'tenant') {
            if ($this->tenant_id === null || $this->tenant_id === '') {
                return res_error('tenant_id is required for export_scope=tenant', 422);
            }

            // TODO (see class doc above): verify $user->user_id is an
            // owner/admin of $this->tenant_id BEFORE enqueueing. Example
            // once tenant-governance is installed:
            //   if (!TenantGovernance::isOwnerOrAdmin((string) $user->user_id, $this->tenant_id)) {
            //       return res_error('Not authorized for this tenant', 403);
            //   }
        }

        // Force-load FnEnqueueDataExportJob.php BEFORE referencing its
        // sibling EnqueueDataExportJobParams class. `php stone generate
        // model` emits Model+Params+Fn as THREE classes in ONE file, named
        // after the Fn class only — composer's PSR-4 (file-per-classname)
        // AND optimized classmap (which only indexes the file's declared
        // primary class per generate-model.php's naming convention) both
        // resolve `App\Database\Functions\FnEnqueueDataExportJob` straight
        // to that file, but neither knows the file ALSO defines
        // EnqueueDataExportJobParams — constructing that class first (the
        // natural call order: build params, then call ::run($params)) hits
        // "Class not found" because nothing has loaded the file yet. This
        // one line is the workaround verified while proving this generator
        // end-to-end; it is a framework-wide gap in the typed Params
        // boundary (every `Fn*::run(ParamsObject)` call site needs it, not
        // just this one) — filed as a separate framework task, not
        // something this generator's own SQL/worker logic can fix.
        class_exists(FnEnqueueDataExportJob::class);

        $params = new EnqueueDataExportJobParams();
        $params->p_requested_by = (string) $user->user_id;
        $params->p_export_scope = $this->export_scope;
        $params->p_tenant_id = $this->tenant_id;
        $params->p_format = $this->format;

        $rows = FnEnqueueDataExportJob::run($params);
        $row = $rows->first();

        if ($row === null) {
            return res_error('Failed to enqueue export', 500);
        }

        // Note: the generated EnqueueDataExportJobModel::$error property is a
        // non-nullable `string` (SQL RETURNS TABLE carries no NULL-ability
        // info the generator can see) — the framework's own
        // Database::array_to_class_object() maps a genuinely NULL o_error
        // column to '' for a non-nullable string property, so '' (not null)
        // is the "no error" sentinel here, not a nullability bug.
        $error = $row->error;
        if ($error !== '' && !str_starts_with($error, 'export_already_in_progress')) {
            return res_error($error, 422);
        }

        // export_already_in_progress is not a failure from the caller's
        // perspective — it hands back the SAME job_uuid the earlier request
        // already got, so a caller polling that id keeps working either way.
        $message = $error !== '' ? 'Export already in progress' : 'Export queued';

        return res_ok([
            'job_uuid'    => $row->job_uuid,
            'status'      => $row->status,
            'enqueued_at' => $row->enqueued_at,
        ], $message);
    }
}

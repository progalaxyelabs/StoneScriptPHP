<?php

declare(strict_types=1);

namespace App\Routes\DataExport;

use App\Database\Functions\EnqueueDataExportJobParams;
use App\Database\Functions\FnEnqueueDataExportJob;
use StoneScriptPHP\ApiResponse;
use StoneScriptPHP\IRouteHandler;

/**
 * POST {prefix}/data-export/enqueue
 *
 * Generated by `php stone generate data-export`. The checkbox-driven
 * enqueue endpoint for the close-account / delete-tenant flow — this is
 * the ONLY thing the request path does (a fast INSERT via
 * enqueue_data_export_job(); see that function's own header comment). It
 * returns immediately with a job_uuid the caller can poll; NO export work
 * happens here.
 *
 * ── AUTHORIZATION — FAIL CLOSED, not a TODO (fixed after independent
 * ── PII/authz review of the first cut of this generator) ──────────────
 * `requested_by` (account scope) is ALWAYS `auth()`'s own identity —
 * never taken from the request body, so an account export can never leak
 * another identity's data.
 *
 * `tenant_id` (tenant scope) is client-supplied (it has to be — the
 * caller is choosing WHICH tenant to export), so `tenantExportIsAuthorized()`
 * below is a POSITIVE, before-enqueue check that the caller is an
 * ACTIVE owner/admin of that exact tenant, wired to the tenant-governance
 * `tenant_memberships` table (`php stone generate tenant-governance`) via
 * `get_identity_tenant_memberships()` — the SAME query
 * `TenantGovernanceResolver::tenantsResolver()` already uses. If
 * tenant-governance is NOT installed on this platform, the check DENIES
 * (403) by default — see the loud fail-closed marker inside that method.
 * Do not delete or bypass it; either install tenant-governance, or replace
 * the method body with this platform's own real, positive ownership check.
 * NEVER make it return true unconditionally "to unblock testing" — that is
 * exactly the cross-tenant PII export hole this class was fixed to close.
 *
 * You own this file — edit freely, e.g. to wire it into a close-account
 * route's own checkbox handling directly instead of a standalone endpoint.
 */
class PostEnqueueDataExportRoute implements IRouteHandler
{
    public string $export_scope = '';
    public ?string $tenant_id = null;
    public string $format = 'csv';

    public function validation_rules(): array
    {
        return [
            'export_scope' => 'required|string|in:account,tenant',
            'tenant_id'    => 'nullable|string|max:255',
            'format'       => 'required|string|in:csv,xlsx',
        ];
    }

    public function process(): ApiResponse
    {
        $user = auth();
        if (!$user || !isset($user->user_id)) {
            return res_error('Authorization required', 401);
        }

        if ($this->export_scope === 'tenant') {
            if ($this->tenant_id === null || $this->tenant_id === '') {
                return res_error('tenant_id is required for export_scope=tenant', 422);
            }

            if (!$this->tenantExportIsAuthorized((string) $user->user_id, $this->tenant_id)) {
                return res_error('Not authorized to export this tenant\'s data', 403);
            }
        }

        // Force-load FnEnqueueDataExportJob.php BEFORE referencing its
        // sibling EnqueueDataExportJobParams class. `php stone generate
        // model` emits Model+Params+Fn as THREE classes in ONE file, named
        // after the Fn class only — composer's PSR-4 (file-per-classname)
        // AND optimized classmap (which only indexes the file's declared
        // primary class per generate-model.php's naming convention) both
        // resolve `App\Database\Functions\FnEnqueueDataExportJob` straight
        // to that file, but neither knows the file ALSO defines
        // EnqueueDataExportJobParams — constructing that class first (the
        // natural call order: build params, then call ::run($params)) hits
        // "Class not found" because nothing has loaded the file yet. This
        // one line is the workaround verified while proving this generator
        // end-to-end; it is a framework-wide gap in the typed Params
        // boundary (every `Fn*::run(ParamsObject)` call site needs it, not
        // just this one) — filed as a separate framework task, not
        // something this generator's own SQL/worker logic can fix.
        class_exists(FnEnqueueDataExportJob::class);

        $config = file_exists(SRC_PATH . 'config' . DIRECTORY_SEPARATOR . 'data-export.php')
            ? require SRC_PATH . 'config' . DIRECTORY_SEPARATOR . 'data-export.php'
            : [];

        $params = new EnqueueDataExportJobParams();
        $params->p_requested_by = (string) $user->user_id;
        $params->p_export_scope = $this->export_scope;
        $params->p_tenant_id = $this->tenant_id;
        $params->p_format = $this->format;
        // Passed explicitly from config so this platform's ceiling is
        // tunable without a SQL change. enqueue_data_export_job() also
        // COALESCEs a NULL to a safe default of its own — belt-and-braces,
        // since the typed Params boundary sends an explicit value (even
        // NULL) for every property rather than truly omitting unset ones.
        $params->p_max_open_per_requester = (int) ($config['max_open_exports_per_requester'] ?? 5);

        $rows = FnEnqueueDataExportJob::run($params);
        $row = $rows->first();

        if ($row === null) {
            return res_error('Failed to enqueue export', 500);
        }

        // Note: the generated EnqueueDataExportJobModel::$error /
        // ::$job_uuid properties are non-nullable `string` (SQL RETURNS
        // TABLE carries no NULL-ability info the generator can see) — the
        // framework's own Database::array_to_class_object() maps a
        // genuinely NULL o_error/o_job_uuid column to '' for a non-nullable
        // string property, so '' (not null) is the "absent" sentinel here.
        $error = $row->error;
        $jobUuid = $row->job_uuid;

        // Any error EXCEPT the "already in progress" case is a hard
        // failure — including enqueue_data_export_job()'s own per-user
        // ceiling rejection (too_many_open_exports). A response with an
        // empty job_uuid is NEVER forwarded as success, regardless of which
        // error string came back — a caller must never be handed a null/
        // empty job_uuid to poll.
        $alreadyInProgress = str_starts_with($error, 'export_already_in_progress');
        if (($error !== '' && !$alreadyInProgress) || $jobUuid === '') {
            return res_error($error !== '' ? $error : 'Failed to enqueue export', $alreadyInProgress ? 409 : 422);
        }

        $message = $alreadyInProgress ? 'Export already in progress' : 'Export queued';

        return res_ok([
            'job_uuid'    => $jobUuid,
            'status'      => $row->status,
            'enqueued_at' => $row->enqueued_at,
        ], $message);
    }

    /**
     * Positive, fail-closed authorization check for export_scope='tenant'.
     * Returns true ONLY if the caller has an ACTIVE tenant_memberships row
     * for $tenantId with is_tenant_owner OR is_tenant_admin true.
     *
     * ⚠️ FAIL-CLOSED MARKER — do not remove without replacing this method's
     * ENTIRE body with a real check. If `php stone generate
     * tenant-governance` has not been run on this platform (detected via
     * class_exists below), this denies EVERY tenant export unconditionally
     * — that is deliberate, not a bug to "fix" by returning true. A
     * platform without tenant-governance must implement its own equivalent
     * positive ownership check here before tenant-scope exports can work at
     * all.
     */
    private function tenantExportIsAuthorized(string $identityId, string $tenantId): bool
    {
        if (!class_exists(\App\Database\Functions\FnGetIdentityTenantMemberships::class)) {
            log_warning(
                'PostEnqueueDataExportRoute: tenant-governance is not installed on this platform ' .
                '(App\\Database\\Functions\\FnGetIdentityTenantMemberships not found) — denying ALL ' .
                'tenant-scope data exports by default (fail-closed). Run `php stone generate ' .
                'tenant-governance`, or replace tenantExportIsAuthorized()\'s body with this ' .
                'platform\'s own real ownership check, before tenant exports can be enabled.'
            );
            return false;
        }

        // Same force-load workaround as FnEnqueueDataExportJob above — this
        // Fn's file also defines a sibling GetIdentityTenantMembershipsParams
        // class that composer's autoloader cannot resolve until the Fn
        // class itself has been referenced once.
        class_exists(\App\Database\Functions\FnGetIdentityTenantMemberships::class);

        $params = new \App\Database\Functions\GetIdentityTenantMembershipsParams();
        $params->p_identity_id = $identityId;

        $memberships = \App\Database\Functions\FnGetIdentityTenantMemberships::run($params);

        foreach ($memberships as $membership) {
            if (
                $membership->tenant_id === $tenantId
                && $membership->status === 'active'
                && ($membership->is_tenant_owner || $membership->is_tenant_admin)
            ) {
                return true;
            }
        }

        return false;
    }
}

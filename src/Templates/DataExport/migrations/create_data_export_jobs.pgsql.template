-- Generated by `php stone generate data-export`. Non-destructive, idempotent
-- DDL only — safe to re-run on any database at any state (this framework's
-- migration-safety rule).
--
-- CREATE TABLE is identical to src/postgresql/tables/data_export_jobs.pgsql
-- (or the nested main-DB equivalent) — the gateway's declarative schema-sync
-- source of truth — kept in sync by hand; this file is what actually runs
-- against an existing database.
CREATE TABLE IF NOT EXISTS data_export_jobs (
    job_uuid             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    requested_by         TEXT NOT NULL,
    export_scope         TEXT NOT NULL CHECK (export_scope IN ('account', 'tenant')),
    tenant_id            TEXT,
    format               TEXT NOT NULL CHECK (format IN ('csv', 'xlsx')),
    status               TEXT NOT NULL DEFAULT 'queued'
                             CHECK (status IN ('queued', 'running', 'succeeded', 'failed', 'expired')),
    artifact_ref         TEXT,
    error_detail         TEXT,
    enqueued_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    picked_up_at         TIMESTAMPTZ,
    terminal_at          TIMESTAMPTZ,
    download_expires_at  TIMESTAMPTZ,

    CONSTRAINT data_export_jobs_tenant_id_matches_scope CHECK (
        (export_scope = 'tenant' AND tenant_id IS NOT NULL)
        OR (export_scope = 'account' AND tenant_id IS NULL)
    )
);

CREATE INDEX IF NOT EXISTS idx_data_export_jobs_queued_by_enqueued ON data_export_jobs(enqueued_at)
    WHERE status = 'queued';

CREATE INDEX IF NOT EXISTS idx_data_export_jobs_requested_by ON data_export_jobs(requested_by);

CREATE INDEX IF NOT EXISTS idx_data_export_jobs_running_by_picked_up ON data_export_jobs(picked_up_at)
    WHERE status = 'running';

CREATE INDEX IF NOT EXISTS idx_data_export_jobs_succeeded_by_expiry ON data_export_jobs(download_expires_at)
    WHERE status = 'succeeded';

CREATE UNIQUE INDEX IF NOT EXISTS idx_data_export_jobs_one_open_per_scope
    ON data_export_jobs(requested_by, export_scope, COALESCE(tenant_id, ''))
    WHERE status IN ('queued', 'running');

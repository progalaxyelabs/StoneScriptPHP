<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

use PDO;

/**
 * CursorStreamer — generated by `php stone generate data-export`.
 *
 * Streams ONE configured table's rows in constant PHP-side memory using a
 * genuine server-side Postgres CURSOR (DECLARE ... CURSOR FOR SELECT ...;
 * FETCH FORWARD N; ... CLOSE) rather than `SELECT *` into a PHP array —
 * this is what makes "NEVER a whole table into memory" true even for a
 * table with millions of rows: only `batch_size` rows ever exist in PHP
 * memory at once, and Postgres itself holds cursor position server-side
 * between FETCHes. Functionally equivalent to `COPY ... TO STDOUT` for this
 * generator's purpose (constant-memory server-side streaming) while staying
 * portable over plain PDO_PGSQL (no dependency on the raw pgsql extension's
 * pg_copy_to(), which is NOT actually streaming — it materializes the whole
 * result as a PHP array despite the name).
 *
 * The cursor is opened and fully drained inside ONE transaction (Postgres
 * requires this for a non-WITH-HOLD cursor) — this class owns that
 * transaction's begin/commit, callers never wrap a call to stream() in
 * their own transaction.
 *
 * ── Bounded, never a fleet-wide autovacuum stall (fixed after independent
 * ── review) ────────────────────────────────────────────────────────────
 * A large export previously held one open transaction for as long as the
 * whole table took to drain, with no timeout — a slow/stuck query (or a
 * PHP-side stall writing a batch, e.g. disk I/O on the XLSX writer) could
 * leave that transaction open indefinitely, which on Postgres blocks
 * autovacuum from reclaiming dead tuples for every OTHER table on the same
 * database — a single export job could degrade the whole fleet sharing
 * that database. `$statementTimeoutMs` bounds any SINGLE DECLARE/FETCH
 * statement; `$idleInTransactionTimeoutMs` bounds how long the transaction
 * may sit idle BETWEEN FETCHes (the window where PHP is writing the
 * previous batch to the CSV/XLSX file) — both `SET LOCAL`, scoped to this
 * transaction only, never touching the session-wide default.
 */
final class CursorStreamer
{
    /**
     * @param array{table:string,columns:string[],where:string,order_by:string} $tableConfig
     * @param array<string,string> $bindings e.g. [':requested_by' => $identityId]
     * @param callable(list<array<string,mixed>>): void $onBatch called once
     *        per batch with up to $batchSize rows (associative, column => value).
     * @return int total row count streamed
     */
    public static function stream(
        PDO $pdo,
        array $tableConfig,
        array $bindings,
        int $batchSize,
        ExportRowBudget $rowBudget,
        int $statementTimeoutMs,
        int $idleInTransactionTimeoutMs,
        callable $onBatch
    ): int {
        self::assertSafeIdentifier($tableConfig['table']);
        foreach ($tableConfig['columns'] as $col) {
            self::assertSafeIdentifier($col);
        }
        self::assertSafeIdentifier($tableConfig['order_by']);
        self::assertWhereReferencesBindings($tableConfig, $bindings);

        $columnList = implode(', ', array_map(fn(string $c) => "\"{$c}\"", $tableConfig['columns']));
        $sql = sprintf(
            'SELECT %s FROM "%s" WHERE %s ORDER BY "%s"',
            $columnList,
            $tableConfig['table'],
            $tableConfig['where'],
            $tableConfig['order_by']
        );

        $cursorName = 'export_cursor_' . bin2hex(random_bytes(6));
        $total = 0;

        $pdo->beginTransaction();
        try {
            // SET LOCAL — scoped to THIS transaction, reset automatically on
            // commit/rollback. Never mutates the connection's session-wide
            // defaults (which WorkerDbConnection's cached PDO reuses across
            // jobs).
            $pdo->exec('SET LOCAL statement_timeout = ' . (int) $statementTimeoutMs);
            $pdo->exec('SET LOCAL idle_in_transaction_session_timeout = ' . (int) $idleInTransactionTimeoutMs);

            $declareStmt = $pdo->prepare("DECLARE {$cursorName} CURSOR FOR {$sql}");
            foreach ($bindings as $param => $value) {
                $declareStmt->bindValue($param, $value);
            }
            $declareStmt->execute();

            while (true) {
                $batch = $pdo->query("FETCH FORWARD {$batchSize} FROM {$cursorName}")->fetchAll();
                if ($batch === [] || $batch === false) {
                    break;
                }

                $rowBudget->consume(count($batch), $tableConfig['table']);
                $total += count($batch);

                $onBatch($batch);

                if (count($batch) < $batchSize) {
                    break; // last (short) batch — cursor is exhausted
                }
            }

            $pdo->exec("CLOSE {$cursorName}");
            $pdo->commit();
        } catch (\Throwable $e) {
            if ($pdo->inTransaction()) {
                $pdo->rollBack();
            }
            throw $e;
        }

        return $total;
    }

    /**
     * Table/column/order_by names in the manifest are platform-developer-
     * authored config, never end-user input — but this guard is cheap
     * insurance against a typo or a future config source that isn't as
     * trusted, matching the same bare-identifier discipline every
     * generator's --tables parsing already applies (see generate-audit.php
     * / generate-soft-delete.php).
     */
    private static function assertSafeIdentifier(string $identifier): void
    {
        if (!preg_match('/^[a-zA-Z_][a-zA-Z0-9_]*$/', $identifier)) {
            throw new \InvalidArgumentException("Unsafe SQL identifier in data-export config: '{$identifier}'");
        }
    }

    /**
     * A manifest table entry whose 'where' predicate does NOT literally
     * contain the bound placeholder (e.g. a typo, or a copy-pasted 'where'
     * left over from a different table) would still bindValue() the
     * parameter without error on most PDO drivers — PDO_PGSQL's default
     * emulated-prepares mode silently accepts a bound name that never
     * appears in the SQL text, so the scoping predicate is effectively
     * DROPPED and the query becomes an unscoped `SELECT ... FROM table`,
     * exporting the WHOLE table to whichever requester/tenant happened to
     * trigger the job. This assertion turns that misconfiguration into an
     * immediate, loud failure at export time instead of a silent full-table
     * data leak.
     *
     * @param array{table:string,columns:string[],where:string,order_by:string} $tableConfig
     * @param array<string,string> $bindings
     */
    private static function assertWhereReferencesBindings(array $tableConfig, array $bindings): void
    {
        foreach (array_keys($bindings) as $placeholder) {
            if (!str_contains($tableConfig['where'], $placeholder)) {
                throw new \InvalidArgumentException(
                    "data-export config error: table '{$tableConfig['table']}'s 'where' clause " .
                    "(\"{$tableConfig['where']}\") does not reference the required placeholder " .
                    "'{$placeholder}' — refusing to export (this misconfiguration would otherwise " .
                    "silently drop the scoping filter and export the WHOLE table)."
                );
            }
        }
    }
}

<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

/**
 * ExportRowBudget — generated by `php stone generate data-export`.
 *
 * A shared, per-JOB row cap. Fixed after independent review found the
 * original implementation applied row_cap PER TABLE (CursorStreamer::stream()
 * took a plain `int $rowCap` argument fresh for every exportTable() call) —
 * a manifest with K tables let a single job export up to K × row_cap rows
 * total, silently larger than what the config's own doc claimed ("hard
 * per-job row cap"). ONE ExportRowBudget instance is now constructed per
 * job and threaded through every exportTable() call for that job, so the
 * cap is enforced across the WHOLE job, not reset per table.
 */
final class ExportRowBudget
{
    private int $remaining;
    private readonly int $cap;

    public function __construct(int $cap)
    {
        $this->cap = $cap;
        $this->remaining = $cap;
    }

    /**
     * @throws ExportRowCapExceededException if this batch pushes the job
     *         over its total cap.
     */
    public function consume(int $rowsInBatch, string $tableName): void
    {
        $this->remaining -= $rowsInBatch;
        if ($this->remaining < 0) {
            throw new ExportRowCapExceededException(
                "row_cap exceeded while exporting table '{$tableName}' (per-job cap={$this->cap})"
            );
        }
    }
}

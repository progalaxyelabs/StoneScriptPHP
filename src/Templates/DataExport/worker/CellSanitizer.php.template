<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

/**
 * CellSanitizer — generated by `php stone generate data-export`.
 *
 * Neutralizes CSV/formula injection (a.k.a. "CSV injection", OWASP-
 * documented) in every exported cell, for BOTH the CSV and XLSX writers.
 * Tenant exports carry customer-controlled fields (e.g. a company name, an
 * address line) that a member of THIS platform's own staff may later open
 * in Excel/Sheets/LibreOffice — if such a value happens to start with
 * `=`, `+`, `-`, `@`, a tab, or a carriage return, the spreadsheet
 * application may interpret it as a formula and execute it (including
 * OS-command-executing formulas in older Excel configurations).
 *
 * Mitigation (the standard OWASP-recommended one): if a STRING cell value's
 * first character is one of the dangerous set, prefix it with a single
 * quote. Excel/Sheets/LibreOffice all treat a leading `'` as "force this
 * cell to plain text" and display the rest of the value unchanged (openspout
 * and SplFileObject::fputcsv both write the literal characters we give
 * them — this class produces the already-safe string, not a
 * spreadsheet-format escape). Applied uniformly regardless of whether the
 * value "looks like" a legitimate negative number (e.g. "-42.00") —
 * per OWASP guidance this is the accepted trade-off: CSV has no cell-type
 * information, so there is no way to distinguish "-42.00 the number" from
 * "-42.00+cmd|...!A1 the injection payload" without it.
 *
 * Only applied to STRING values — PHP int/float/bool values from PDO are
 * inherently safe (a real numeric type can never carry a formula prefix);
 * they are returned unchanged (after the same scalar/JSON handling the
 * exporters already did before this class existed).
 */
final class CellSanitizer
{
    private const DANGEROUS_PREFIXES = ['=', '+', '-', '@', "\t", "\r"];

    public static function sanitize(mixed $value): string|int|float|bool
    {
        if (!is_string($value) || $value === '') {
            return $value;
        }

        foreach (self::DANGEROUS_PREFIXES as $prefix) {
            if (str_starts_with($value, $prefix)) {
                return "'" . $value;
            }
        }

        return $value;
    }
}

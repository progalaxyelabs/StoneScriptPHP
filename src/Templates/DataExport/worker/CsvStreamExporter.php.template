<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

/**
 * CsvStreamExporter — generated by `php stone generate data-export`.
 *
 * Writes one table's rows to a CSV file, one CursorStreamer batch at a time
 * — `fputcsv()` per row, immediately, never buffering more than one batch
 * (config('batch_size') rows) in memory. Multiple tables in the same scope
 * are written as consecutive sections in ONE file (a "-- table: X --"
 * marker line + its own header row), since CSV has no concept of multiple
 * sheets — this keeps the CSV and XLSX exporters' external contract
 * (one artifact file per job) identical.
 */
final class CsvStreamExporter
{
    private \SplFileObject $file;
    private bool $wroteAnyTable = false;

    public function __construct(string $destinationPath)
    {
        $this->file = new \SplFileObject($destinationPath, 'w');
    }

    /**
     * @param array{table:string,columns:string[],where:string,order_by:string} $tableConfig
     * @param array<string,string> $bindings
     */
    public function exportTable(
        \PDO $pdo,
        array $tableConfig,
        array $bindings,
        int $batchSize,
        int $rowCap
    ): int {
        if ($this->wroteAnyTable) {
            $this->file->fwrite("\n");
        }
        $this->wroteAnyTable = true;

        $this->file->fwrite("# table: {$tableConfig['table']}\n");
        $this->file->fputcsv($tableConfig['columns'], escape: '\\');

        return CursorStreamer::stream(
            $pdo,
            $tableConfig,
            $bindings,
            $batchSize,
            $rowCap,
            function (array $batch): void {
                foreach ($batch as $row) {
                    $this->file->fputcsv(array_map(
                        static fn($v) => $v === null ? '' : (is_scalar($v) ? $v : json_encode($v)),
                        array_values($row)
                    ), escape: '\\');
                }
            }
        );
    }

    public function close(): void
    {
        // SplFileObject has no explicit close()/flush() call that returns a
        // status — fflush() on its wrapped stream is the deterministic way
        // to guarantee every byte is on disk BEFORE the worker calls
        // complete_export_job() with this file's path as artifact_ref (a
        // reader must never observe a job marked 'succeeded' whose file is
        // still partially buffered).
        $this->file->fflush();
        unset($this->file);
    }
}

<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

use OpenSpout\Common\Entity\Row;
use OpenSpout\Writer\XLSX\Writer;

/**
 * XlsxStreamExporter — generated by `php stone generate data-export`.
 *
 * Uses openspout/openspout (NOT phpoffice/phpspreadsheet — PhpSpreadsheet
 * builds an in-memory Spreadsheet object graph for every cell and is not
 * genuinely constant-memory even with formula precalculation disabled;
 * openspout writes each row straight to the underlying ZIP/XML stream as
 * addRow() is called and never holds more than the current row in memory —
 * this is the actual reason this generator requires it. Add it with:
 *   composer require openspout/openspout
 *
 * One sheet per table (openspout supports multiple sheets natively, unlike
 * CSV's single-stream limitation) — addNewSheetAndMakeItCurrent() per
 * table, named after the table (truncated to Excel's 31-char sheet-name
 * limit).
 */
final class XlsxStreamExporter
{
    private Writer $writer;
    private bool $wroteAnyTable = false;

    public function __construct(string $destinationPath)
    {
        $this->writer = new Writer();
        $this->writer->openToFile($destinationPath);
    }

    /**
     * @param array{table:string,columns:string[],where:string,order_by:string} $tableConfig
     * @param array<string,string> $bindings
     */
    public function exportTable(
        \PDO $pdo,
        array $tableConfig,
        array $bindings,
        int $batchSize,
        int $rowCap
    ): int {
        if ($this->wroteAnyTable) {
            $this->writer->addNewSheetAndMakeItCurrent();
        }
        $this->wroteAnyTable = true;

        $sheetName = substr($tableConfig['table'], 0, 31);
        $this->writer->getCurrentSheet()->setName($sheetName);

        $this->writer->addRow(Row::fromValues($tableConfig['columns']));

        return CursorStreamer::stream(
            $pdo,
            $tableConfig,
            $bindings,
            $batchSize,
            $rowCap,
            function (array $batch): void {
                foreach ($batch as $row) {
                    $this->writer->addRow(Row::fromValues(array_map(
                        static fn($v) => $v === null ? '' : (is_scalar($v) ? $v : json_encode($v)),
                        array_values($row)
                    )));
                }
            }
        );
    }

    public function close(): void
    {
        // openspout flushes and finalizes the ZIP/XML stream on close() —
        // same "must be fully on disk before complete_export_job() runs"
        // requirement as CsvStreamExporter::close().
        $this->writer->close();
    }
}

<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

use App\Database\Functions\ClaimExportJobModel;
use App\Database\Functions\ClaimExportJobParams;
use App\Database\Functions\CompleteExportJobParams;
use App\Database\Functions\FailExportJobParams;
use App\Database\Functions\FnClaimExportJob;
use App\Database\Functions\FnCompleteExportJob;
use App\Database\Functions\FnFailExportJob;

/**
 * ExportWorker — generated by `php stone generate data-export`.
 *
 * The per-platform, owner-decided (2026-08-24 design doc) export worker:
 * claim -> stream -> complete/fail, over THIS platform's own database via
 * WorkerDbConnection (direct PDO — see that class's header for why this is
 * a deliberate, documented exception to the gateway-only rule). NOT
 * gateway-hosted — the gateway stays pure infra and never reads business
 * data (owner decision).
 *
 * Concurrency + streaming are enforced HERE, not left to per-platform
 * discretion (owner constraint: the worker must not choke the platform):
 *   - config('concurrency') bounds how many jobs run() claims per call.
 *   - Every table is streamed via CursorStreamer (constant memory) — never
 *     `SELECT *` into one PHP array.
 *   - config('row_cap') fails a job loudly rather than silently truncating
 *     an export that turned out larger than expected.
 *
 * Uses the framework's typed `Fn*::run(ParamsObject)` / `TypedArray<Model>`
 * boundary throughout (Database::fnTyped / result_as_typed_table — see `php
 * stone generate model`'s output), NOT raw positional args or plain arrays.
 * `tenant_id` on ClaimExportJobModel is a NON-nullable `string` (the SQL
 * RETURNS TABLE declaration carries no NULL-ability info the generator can
 * see) — the framework's own Database::array_to_class_object() maps a
 * genuinely NULL o_tenant_id column to '' for that property, so '' (not
 * null) means "no tenant" (account scope) here, matching
 * EnqueueDataExportJobModel::$error's same documented behavior in
 * PostEnqueueDataExportRoute.
 *
 * You own this file — edit freely (e.g. to upload artifact_ref to object
 * storage instead of local disk before calling completeJob()).
 */
final class ExportWorker
{
    /** @var array<string,mixed> */
    private array $config;

    public function __construct(?array $config = null)
    {
        $this->config = $config ?? require dirname(__DIR__, 3) . '/config/data-export.php';

        // Force-load every FnXxx.php file used below BEFORE any of its
        // sibling Params/Model classes are referenced. See
        // PostEnqueueDataExportRoute's identical line for the full
        // explanation — `php stone generate model` emits Model+Params+Fn as
        // THREE classes in ONE file named after the Fn class only, so
        // composer's autoloader (PSR-4 or optimized classmap, verified both)
        // can't resolve the sibling classes until the Fn class itself has
        // been loaded at least once. Doing it once here, up front, is
        // simpler than repeating it at every one of this worker's three
        // call sites.
        class_exists(FnClaimExportJob::class);
        class_exists(FnCompleteExportJob::class);
        class_exists(FnFailExportJob::class);
    }

    /**
     * Runs ONE claim-and-drain pass: claims up to config('concurrency') jobs
     * and processes them SEQUENTIALLY (one worker process, one PDO
     * connection — true parallelism would need multiple worker PROCESSES,
     * each with their own connection; see config('concurrency')'s own
     * comment on why that requires raising this value deliberately, not
     * just starting more processes). Returns the number of jobs processed
     * (0 means the queue was empty — the caller's loop should sleep before
     * calling again).
     */
    public function runOnce(): int
    {
        $limit = max(1, (int) ($this->config['concurrency'] ?? 1));

        $params = new ClaimExportJobParams();
        $params->p_limit = $limit;
        $jobs = FnClaimExportJob::run($params);

        foreach ($jobs as $job) {
            $this->processJob($job);
        }

        return count($jobs);
    }

    private function processJob(ClaimExportJobModel $job): void
    {
        $jobUuid = $job->job_uuid;

        try {
            $artifactPath = $this->exportJob($job);

            $expiresAt = (new \DateTimeImmutable('now', new \DateTimeZone('UTC')))
                ->modify('+' . (int) ($this->config['download_ttl_hours'] ?? 72) . ' hours')
                ->format('Y-m-d H:i:sP');

            $completeParams = new CompleteExportJobParams();
            $completeParams->p_job_uuid = $jobUuid;
            $completeParams->p_artifact_ref = $artifactPath;
            $completeParams->p_expires_at = $expiresAt;
            FnCompleteExportJob::run($completeParams);
        } catch (\Throwable $e) {
            // Job-lifecycle LAW: every job reaches a terminal state, no
            // exceptions — a partially-written artifact from a failed run is
            // left on disk for operator inspection (not auto-deleted; add
            // cleanup yourself if disk usage from failed runs becomes a
            // concern) but the JOB ROW itself always terminates.
            $failParams = new FailExportJobParams();
            $failParams->p_job_uuid = $jobUuid;
            $failParams->p_error = substr($e->getMessage(), 0, 2000);
            FnFailExportJob::run($failParams);
        }
    }

    /**
     * @return string the artifact_ref (local file path) to persist
     */
    private function exportJob(ClaimExportJobModel $job): string
    {
        $scope = $job->export_scope;
        $format = $job->format;
        $requestedBy = $job->requested_by;
        $tenantId = $job->tenant_id !== '' ? $job->tenant_id : null;

        $tables = $scope === 'account'
            ? ($this->config['account'] ?? [])
            : ($this->config['tenants'] ?? []);

        if ($tables === []) {
            throw new \RuntimeException(
                "data-export config has no tables configured for scope '{$scope}' — " .
                "edit src/config/data-export.php before this scope can be exported."
            );
        }

        $bindings = $scope === 'account'
            ? [':requested_by' => $requestedBy]
            : [':tenant_id' => $tenantId];

        $artifactDir = rtrim((string) ($this->config['artifact_dir'] ?? sys_get_temp_dir()), '/');
        if (!is_dir($artifactDir) && !mkdir($artifactDir, 0750, true) && !is_dir($artifactDir)) {
            throw new \RuntimeException("Could not create artifact_dir: {$artifactDir}");
        }

        $extension = $format === 'xlsx' ? 'xlsx' : 'csv';
        $filename = "export_{$scope}_{$job->job_uuid}.{$extension}";
        $destinationPath = $artifactDir . '/' . $filename;

        $pdo = WorkerDbConnection::get();
        $batchSize = (int) ($this->config['batch_size'] ?? 1000);
        $rowCap = (int) ($this->config['row_cap'] ?? 500000);

        $exporter = $format === 'xlsx'
            ? new XlsxStreamExporter($destinationPath)
            : new CsvStreamExporter($destinationPath);

        try {
            foreach ($tables as $tableConfig) {
                $exporter->exportTable($pdo, $tableConfig, $bindings, $batchSize, $rowCap);
            }
        } finally {
            $exporter->close();
        }

        return $destinationPath;
    }
}

<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

use App\Database\Functions\ClaimExportJobModel;
use App\Database\Functions\ClaimExportJobParams;
use App\Database\Functions\CompleteExportJobParams;
use App\Database\Functions\FailExportJobParams;
use App\Database\Functions\FnClaimExportJob;
use App\Database\Functions\FnCompleteExportJob;
use App\Database\Functions\FnExpireSucceededExportJobs;
use App\Database\Functions\FnFailExportJob;
use App\Database\Functions\FnReapStaleExportJobs;
use App\Database\Functions\ReapStaleExportJobsParams;

/**
 * ExportWorker — generated by `php stone generate data-export`.
 *
 * The per-platform, owner-decided (2026-08-24 design doc) export worker:
 * claim -> stream -> complete/fail, over THIS platform's own database via
 * WorkerDbConnection (direct PDO — see that class's header for why this is
 * a deliberate, documented exception to the gateway-only rule). NOT
 * gateway-hosted — the gateway stays pure infra and never reads business
 * data (owner decision).
 *
 * Concurrency + streaming are enforced HERE, not left to per-platform
 * discretion (owner constraint: the worker must not choke the platform):
 *   - config('concurrency') bounds how many jobs run() claims per call.
 *   - Every table is streamed via CursorStreamer (constant memory) — never
 *     `SELECT *` into one PHP array.
 *   - config('row_cap') is a TRUE per-job cap (one ExportRowBudget shared
 *     across every table in the job — see that class's own doc for the bug
 *     this fixed) and fails loudly rather than silently truncating.
 *
 * ── Fail-closed data-integrity checks (added after independent review) ────
 *   - A tenant-scope job REQUIRES config('tenancy_mode') to be explicitly
 *     'single' or 'db_per_tenant', and if 'db_per_tenant', REQUIRES
 *     config('resolve_tenant_database') to return a real database name —
 *     never falls back to the default database. Querying the WRONG
 *     database on a db-per-tenant fleet would return an empty (or another
 *     tenant's) result set and still report 'succeeded' — nothing about an
 *     empty file looks like a bug from the outside, so this fails the job
 *     instead of guessing.
 *   - An account-scope job that streams ZERO rows across every configured
 *     table is treated as suspect (a misconfigured manifest, or a
 *     requested_by that doesn't match any row) and fails loudly rather
 *     than silently emitting a headers-only "success" file. Tenant-scope
 *     jobs do NOT get this check — a brand-new tenant legitimately having
 *     no data yet is not an error.
 *
 * Uses the framework's typed `Fn*::run(ParamsObject)` / `TypedArray<Model>`
 * boundary throughout (Database::fnTyped / result_as_typed_table — see `php
 * stone generate model`'s output), NOT raw positional args or plain arrays.
 * `tenant_id` on ClaimExportJobModel is a NON-nullable `string` (the SQL
 * RETURNS TABLE declaration carries no NULL-ability info the generator can
 * see) — the framework's own Database::array_to_class_object() maps a
 * genuinely NULL o_tenant_id column to '' for that property, so '' (not
 * null) means "no tenant" (account scope) here, matching
 * EnqueueDataExportJobModel::$error's same documented behavior in
 * PostEnqueueDataExportRoute.
 *
 * You own this file — edit freely (e.g. to upload artifact_ref to object
 * storage instead of local disk before calling completeJob()).
 */
final class ExportWorker
{
    /** @var array<string,mixed> */
    private array $config;

    public function __construct(?array $config = null)
    {
        $this->config = $config ?? require dirname(__DIR__, 3) . '/config/data-export.php';

        // Force-load every FnXxx.php file used below BEFORE any of its
        // sibling Params/Model classes are referenced. See
        // PostEnqueueDataExportRoute's identical line for the full
        // explanation — `php stone generate model` emits Model+Params+Fn as
        // THREE classes in ONE file named after the Fn class only, so
        // composer's autoloader (PSR-4 or optimized classmap, verified both)
        // can't resolve the sibling classes until the Fn class itself has
        // been loaded at least once. Doing it once here, up front, is
        // simpler than repeating it at every one of this worker's call
        // sites.
        class_exists(FnClaimExportJob::class);
        class_exists(FnCompleteExportJob::class);
        class_exists(FnFailExportJob::class);
        class_exists(FnReapStaleExportJobs::class);
        class_exists(FnExpireSucceededExportJobs::class);
    }

    /**
     * Runs ONE claim-and-drain pass: claims up to config('concurrency') jobs
     * and processes them SEQUENTIALLY (one worker process, one PDO
     * connection per resolved database — true parallelism would need
     * multiple worker PROCESSES, each with their own connection; see
     * config('concurrency')'s own comment on why that requires raising this
     * value deliberately, not just starting more processes). Returns the
     * number of jobs processed (0 means the queue was empty — the caller's
     * loop should sleep before calling again).
     */
    public function runOnce(): int
    {
        $limit = max(1, (int) ($this->config['concurrency'] ?? 1));

        $params = new ClaimExportJobParams();
        $params->p_limit = $limit;
        $jobs = FnClaimExportJob::run($params);

        foreach ($jobs as $job) {
            $this->processJob($job);
        }

        return count($jobs);
    }

    /**
     * Background maintenance — cheap, indexed SQL + local file deletes.
     * Call this periodically (the worker CLI calls it once per --loop
     * iteration and once for --once/--reap — see bin/export-worker.php),
     * NOT on every single claimed job (no need for that granularity):
     *   1. reap_stale_export_jobs() — a crashed worker's abandoned
     *      'running' rows are marked 'failed' (job-lifecycle LAW: every job
     *      reaches terminal; also frees that requester's admission slot).
     *   2. expire_succeeded_export_jobs() — succeeded jobs past their TTL
     *      transition to 'expired' AND this method deletes their plaintext
     *      artifact file from disk (PII must not accumulate indefinitely).
     *
     * @return array{reaped_stale:int,expired_artifacts:int}
     */
    public function runMaintenance(): array
    {
        $staleAfterMinutes = (int) ($this->config['stale_running_after_minutes'] ?? 30);
        $reapParams = new ReapStaleExportJobsParams();
        $reapParams->p_stale_after = "{$staleAfterMinutes} minutes";
        $reaped = FnReapStaleExportJobs::run($reapParams);

        // No input params — generate-model.php emits a bare `run(): TypedArray`
        // (no Params class at all) when the SQL function takes zero arguments.
        $expired = FnExpireSucceededExportJobs::run();

        $deletedCount = 0;
        foreach ($expired as $expiredJob) {
            $artifactRef = $expiredJob->artifact_ref;
            if ($artifactRef !== '' && is_file($artifactRef)) {
                if (@unlink($artifactRef)) {
                    $deletedCount++;
                } else {
                    log_warning("ExportWorker::runMaintenance: failed to delete expired artifact file: {$artifactRef}");
                }
            }
        }

        return ['reaped_stale' => count($reaped), 'expired_artifacts' => $deletedCount];
    }

    private function processJob(ClaimExportJobModel $job): void
    {
        $jobUuid = $job->job_uuid;
        $artifactPath = null;

        try {
            $artifactPath = $this->exportJob($job);

            $expiresAt = (new \DateTimeImmutable('now', new \DateTimeZone('UTC')))
                ->modify('+' . (int) ($this->config['download_ttl_hours'] ?? 72) . ' hours')
                ->format('Y-m-d H:i:sP');

            $completeParams = new CompleteExportJobParams();
            $completeParams->p_job_uuid = $jobUuid;
            $completeParams->p_artifact_ref = $artifactPath;
            $completeParams->p_expires_at = $expiresAt;
            FnCompleteExportJob::run($completeParams);
        } catch (\Throwable $e) {
            // Job-lifecycle LAW: every job reaches a terminal state, no
            // exceptions.
            $failParams = new FailExportJobParams();
            $failParams->p_job_uuid = $jobUuid;
            $failParams->p_error = substr($e->getMessage(), 0, 2000);
            FnFailExportJob::run($failParams);

            // A failed job's PARTIAL artifact file (if the exporter got far
            // enough to create one before the error) is deleted immediately
            // — fixed after independent review: the original left it on
            // disk indefinitely, a plaintext PII file with no job pointing
            // at it and nothing scheduled to ever clean it up.
            if ($artifactPath !== null && is_file($artifactPath)) {
                if (!@unlink($artifactPath)) {
                    log_warning("ExportWorker::processJob: failed to delete partial artifact after job failure: {$artifactPath}");
                }
            }
        }
    }

    /**
     * @return string the artifact_ref (local file path) to persist
     */
    private function exportJob(ClaimExportJobModel $job): string
    {
        $scope = $job->export_scope;
        $format = $job->format;
        $requestedBy = $job->requested_by;
        $tenantId = $job->tenant_id !== '' ? $job->tenant_id : null;

        $tables = $scope === 'account'
            ? ($this->config['account'] ?? [])
            : ($this->config['tenants'] ?? []);

        if ($tables === []) {
            throw new \RuntimeException(
                "data-export config has no tables configured for scope '{$scope}' — " .
                "edit src/config/data-export.php before this scope can be exported."
            );
        }

        $bindings = $scope === 'account'
            ? [':requested_by' => $requestedBy]
            : [':tenant_id' => $tenantId];

        // ── Database resolution (fixed after independent review) ─────────
        // Account-scope jobs always use the default database. Tenant-scope
        // jobs REQUIRE an explicit tenancy_mode — never guess between
        // "shared DB" and "DB-per-tenant", because guessing wrong on a
        // db_per_tenant fleet queries an empty/wrong database and the job
        // would otherwise still report 'succeeded'.
        $databaseNameOverride = null;
        if ($scope === 'tenant') {
            $tenancyMode = $this->config['tenancy_mode'] ?? null;
            if ($tenancyMode === 'db_per_tenant') {
                $resolver = $this->config['resolve_tenant_database'] ?? null;
                if (!is_callable($resolver)) {
                    throw new \RuntimeException(
                        "data-export config error: tenancy_mode is 'db_per_tenant' but " .
                        "'resolve_tenant_database' is not a callable — refusing to export " .
                        "tenant_id='{$tenantId}' against an unresolved database."
                    );
                }
                $databaseNameOverride = $resolver($tenantId);
                if ($databaseNameOverride === null || $databaseNameOverride === '') {
                    throw new \RuntimeException(
                        "data-export: resolve_tenant_database(tenant_id='{$tenantId}') returned no " .
                        "database name — refusing to export against an unresolved/wrong database."
                    );
                }
            } elseif ($tenancyMode !== 'single') {
                throw new \RuntimeException(
                    "data-export config error: 'tenancy_mode' must be explicitly 'single' or " .
                    "'db_per_tenant' (got " . var_export($tenancyMode, true) . ") — refusing to guess " .
                    "which database tenant_id='{$tenantId}''s rows live in."
                );
            }
        }

        $artifactDir = rtrim((string) ($this->config['artifact_dir'] ?? sys_get_temp_dir()), '/');
        if (!is_dir($artifactDir) && !mkdir($artifactDir, 0750, true) && !is_dir($artifactDir)) {
            throw new \RuntimeException("Could not create artifact_dir: {$artifactDir}");
        }

        $extension = $format === 'xlsx' ? 'xlsx' : 'csv';
        $filename = "export_{$scope}_{$job->job_uuid}.{$extension}";
        $destinationPath = $artifactDir . '/' . $filename;

        $pdo = WorkerDbConnection::get($databaseNameOverride);
        $batchSize = (int) ($this->config['batch_size'] ?? 1000);
        $rowBudget = new ExportRowBudget((int) ($this->config['row_cap'] ?? 500000));
        $statementTimeoutMs = (int) ($this->config['cursor_statement_timeout_ms'] ?? 120000);
        $idleInTransactionTimeoutMs = (int) ($this->config['cursor_idle_in_transaction_timeout_ms'] ?? 60000);

        $exporter = $format === 'xlsx'
            ? new XlsxStreamExporter($destinationPath)
            : new CsvStreamExporter($destinationPath);

        $totalRows = 0;
        try {
            foreach ($tables as $tableConfig) {
                $totalRows += $exporter->exportTable(
                    $pdo,
                    $tableConfig,
                    $bindings,
                    $batchSize,
                    $rowBudget,
                    $statementTimeoutMs,
                    $idleInTransactionTimeoutMs
                );
            }
        } catch (\Throwable $e) {
            // Delete the partial file HERE, not only in processJob()'s
            // catch — fixed after independent review found a real gap:
            // an exception thrown mid-stream (row_cap exceeded, a cursor
            // error, ...) unwinds out of THIS method before it ever
            // returns $destinationPath, so processJob()'s own
            // `$artifactPath !== null` cleanup check never fires (the
            // local variable it guards was never assigned). Close the
            // exporter first so the partial file isn't still open/locked,
            // then delete it, then re-throw so fail_export_job() still
            // runs as normal.
            $exporter->close();
            if (is_file($destinationPath) && !@unlink($destinationPath)) {
                log_warning("ExportWorker::exportJob: failed to delete partial artifact after mid-export failure: {$destinationPath}");
            }
            throw $e;
        }
        $exporter->close();

        // A zero-row ACCOUNT export is suspect (see class doc) — fail
        // loudly instead of marking succeeded with an effectively-empty
        // file. Tenant-scope jobs are exempt: a brand-new tenant with no
        // data yet is legitimate.
        if ($scope === 'account' && $totalRows === 0) {
            @unlink($destinationPath);
            throw new \RuntimeException(
                "account export for requested_by='{$requestedBy}' produced zero rows across every " .
                "configured table — refusing to mark succeeded (possible identity mismatch, or a " .
                "misconfigured src/config/data-export.php manifest)."
            );
        }

        return $destinationPath;
    }
}

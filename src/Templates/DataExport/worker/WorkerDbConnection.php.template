<?php

declare(strict_types=1);

namespace App\Lib\DataExport;

use PDO;

/**
 * WorkerDbConnection — generated by `php stone generate data-export`.
 *
 * A DELIBERATE, DOCUMENTED exception to this framework's "API servers NEVER
 * connect directly to PostgreSQL, everything goes through
 * StoneScriptPHP\Database::fn()" rule. That rule protects the REQUEST path
 * (route handlers, business logic reachable from an HTTP request) — the
 * export worker is not that: it is an out-of-band background process,
 * started by cron/systemd/supervisor, that never handles a live request. It
 * needs a genuine SQL CURSOR (DECLARE ... CURSOR + chunked FETCH) to stream
 * arbitrarily large result sets in constant PHP-side memory — something
 * Database::fn()'s "call one named function, get one full array of rows
 * back" contract cannot express, and something the gateway's HTTP transport
 * cannot stream through without buffering the whole response either.
 *
 * Reuses the SAME env vars `DB_MODE=direct` already defines
 * (DB_HOST/DB_PORT/DB_USER/DB_PASSWORD, DB_NAME as the default database —
 * see StoneScriptPHP\Env and StoneScriptPHP\Db\DirectTransport) so there is
 * only one place to configure direct Postgres credentials, even though the
 * API server itself may stay on DB_MODE=gateway. Requires ext-pdo_pgsql.
 *
 * ── Multiple databases, one server (db-per-tenant support, fixed after
 * ── independent review) ────────────────────────────────────────────────
 * On a fleet that provisions ONE Postgres DATABASE PER TENANT
 * ({platform}_{tenant} — see ExportWorker's tenancy_mode handling), a
 * tenant-scope job must query THAT tenant's own database, never the
 * account/main one DB_NAME points at. get() now accepts an optional
 * database-name override and caches one PDO connection PER database name
 * (same host/port/user/password for all of them — this class assumes
 * every tenant database lives on the SAME Postgres server as DB_HOST/
 * DB_PORT; a fleet that also shards ACROSS SERVERS per tenant needs a
 * further per-host override, which is a straightforward extension of this
 * same cache-by-key pattern but is out of scope for what this generator can
 * assume about an arbitrary platform's infrastructure).
 */
final class WorkerDbConnection
{
    /** @var array<string, PDO> keyed by resolved database name */
    private static array $connections = [];

    public static function get(?string $databaseNameOverride = null): PDO
    {
        if (!extension_loaded('pdo_pgsql')) {
            throw new \RuntimeException(
                'The data-export worker requires the pdo_pgsql PHP extension (same requirement as DB_MODE=direct).'
            );
        }

        $host = getenv('DB_HOST') ?: 'localhost';
        $port = getenv('DB_PORT') ?: '5432';
        $name = $databaseNameOverride ?? (getenv('DB_NAME') ?: '');
        $user = getenv('DB_USER') ?: 'postgres';
        $pass = getenv('DB_PASSWORD') ?: null;

        if ($name === '') {
            throw new \RuntimeException(
                'DB_NAME is required for the data-export worker (same env var DB_MODE=direct uses). ' .
                'Set it to the default database this worker should export FROM — usually this ' .
                'platform\'s own main database (account-scope exports always use it; tenant-scope ' .
                'exports use it too UNLESS tenancy_mode is db_per_tenant, in which case each job ' .
                'resolves its own tenant database — see ExportWorker\'s tenancy handling).'
            );
        }

        if (isset(self::$connections[$name])) {
            return self::$connections[$name];
        }

        $dsn = "pgsql:host={$host};port={$port};dbname={$name}";
        self::$connections[$name] = new PDO($dsn, $user, $pass, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        ]);

        return self::$connections[$name];
    }

    /**
     * Reset all cached connections — test-only (a fresh worker process
     * normally lives for the life of one `--loop` run, so production code
     * never needs this).
     */
    public static function reset(): void
    {
        self::$connections = [];
    }
}

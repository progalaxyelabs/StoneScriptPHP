-- data_export_jobs — durable "control plane" row for the async, streaming
-- user-data-download feature (owner priority: 100% user-data
-- CSV/XLSX download). Generated by `php stone generate data-export`.
--
-- Follows this codebase's standard durable-job-ledger shape (queued ->
-- running -> succeeded|failed, enqueued_at/picked_up_at/terminal_at) applied
-- to a different domain: exporting a user's own data instead of provisioning
-- infrastructure. Same job-lifecycle LAW every such ledger in this framework
-- follows: every job reaches a terminal state, admission control is
-- enforced at enqueue (not left to application-level checks), and a claimed
-- job is durably visible as 'running' the instant it's picked up.
--
-- ## Two scopes, never merged
-- export_scope='account' -> the REQUESTING IDENTITY's own rows, across
-- whatever tables this platform's src/config/data-export.php lists under
-- 'account' (tenant_id is NULL — an account export is not scoped to any one
-- tenant). export_scope='tenant' -> one tenant's rows (tenant_id required),
-- authorized only for an owner/admin of that tenant. The CHECK constraint
-- below enforces tenant_id's presence/absence matches the scope; the
-- AUTHORIZATION check (is this requester allowed to export this tenant?)
-- is application-layer, done once in enqueue_data_export_job() by the
-- CALLING route (see routes/PostEnqueueDataExportRoute.php.template) BEFORE
-- it ever calls this table's enqueue function — never trust export_scope or
-- tenant_id values from the request body alone.
--
-- ## Admission control — one open export per (requester, scope, tenant)
-- A partial UNIQUE index (not an application-level SELECT-then-INSERT,
-- which would TOCTOU-race two near-simultaneous enqueue calls) makes
-- enqueue_data_export_job()'s INSERT itself race-free — Postgres serializes
-- concurrent INSERTs against the same (requested_by, export_scope,
-- tenant_id) via this index; only one ever wins. tenant_id is normalized
-- through COALESCE(tenant_id, '') in the index expression because Postgres
-- treats NULL <> NULL in a plain unique index — without the COALESCE, two
-- concurrent 'account'-scope requests from the same requester (both having
-- tenant_id IS NULL) would NOT collide and both would be admitted, silently
-- defeating the "one open export" guarantee for every account-scope export
-- on the platform.
--
-- ## artifact_ref / download_expires_at
-- artifact_ref is an opaque per-worker storage reference (a local file path
-- on the platform's own VM by default — see worker/ExportWorker.php.template
-- — or an object-storage key if a given platform's worker is customized to
-- upload elsewhere). download_expires_at is set by the worker on success;
-- NOTHING in this generator serves the file to the end user — that is the
-- account-portal download endpoint's job, an explicitly OUT-OF-SCOPE seam
-- (see this generator's --help output for the exact contract it must honor:
-- read artifact_ref + download_expires_at, 404/410 once expired, and it is
-- the only thing that should ever set status='expired').
CREATE TABLE IF NOT EXISTS data_export_jobs (
    job_uuid             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    requested_by         TEXT NOT NULL,
    export_scope         TEXT NOT NULL CHECK (export_scope IN ('account', 'tenant')),
    tenant_id            TEXT,
    format               TEXT NOT NULL CHECK (format IN ('csv', 'xlsx')),
    status               TEXT NOT NULL DEFAULT 'queued'
                             CHECK (status IN ('queued', 'running', 'succeeded', 'failed', 'expired')),
    artifact_ref         TEXT,
    error_detail         TEXT,
    enqueued_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    picked_up_at         TIMESTAMPTZ,
    terminal_at          TIMESTAMPTZ,
    download_expires_at  TIMESTAMPTZ,

    CONSTRAINT data_export_jobs_tenant_id_matches_scope CHECK (
        (export_scope = 'tenant' AND tenant_id IS NOT NULL)
        OR (export_scope = 'account' AND tenant_id IS NULL)
    )
);

-- claim_export_job()'s FOR UPDATE SKIP LOCKED scan target — oldest queued
-- job first, small forever (partial index, terminal rows excluded).
CREATE INDEX IF NOT EXISTS idx_data_export_jobs_queued_by_enqueued ON data_export_jobs(enqueued_at)
    WHERE status = 'queued';

CREATE INDEX IF NOT EXISTS idx_data_export_jobs_requested_by ON data_export_jobs(requested_by);

-- Admission control (see header comment above) — one open (queued/running)
-- export per (requester, scope, tenant). COALESCE keeps NULL tenant_id
-- (account scope) from silently defeating uniqueness.
CREATE UNIQUE INDEX IF NOT EXISTS idx_data_export_jobs_one_open_per_scope
    ON data_export_jobs(requested_by, export_scope, COALESCE(tenant_id, ''))
    WHERE status IN ('queued', 'running');

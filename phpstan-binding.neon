# Scoped PHPStan config for the typed-request-binder feature
# (SPEC-typed-request-binder.md) — run at `level: max`, the bar the task
# brief asked for on the NEW code specifically. The framework's own baseline
# config (phpstan.neon) stays at level 5 (the fleet standard) for the
# pre-existing ~30k-line codebase; ratcheting the whole framework to max is a
# separate, much larger effort outside this feature's scope.
#
# Run: php vendor/bin/phpstan analyse -c phpstan-binding.neon
parameters:
    level: max
    paths:
        - src/Binding
        - src/ITypedRouteHandler.php
    treatPhpDocTypesAsCertain: false
